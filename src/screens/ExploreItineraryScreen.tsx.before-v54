  const [locationResults,setLocationResults]=useState<Location[]>([]);
  const [pin,setPin]=useState<Coord|null>(null);
  const [stops,setStops]=useState<Location[]>([]);
  const [attractions,setAttractions]=useState<Place[]>([]);
