  const [error,setError]=useState('');
  const [online,setOnline]=useState<boolean|null>(null);
  const [showMore,setShowMore]=useState(false);
  const request=useRef(0),routeRequest=useRef(0),priceRequest=useRef(0);
  const cache=useRef(new Map<string,Place[]>());
  useEffect(()=>{
    if(journey && activeLegKey.startsWith('day:')){
      setLegCache(prev=>({...prev,[activeLegKey]:journey}));
    }
  },[journey,activeLegKey]);

  useEffect(()=>{api<any>('/health').then(h=>setOnline(h.status==='ok'&&h.database==='connected')).catch(()=>setOnline(false));},[]);
  useEffect(()=>{
    if(stage!=='city'||query.trim().length<2){setCities([]);return;}
    const id=++request.current;
    const timer=setTimeout(()=>api<{cities:City[]}>(`/api/cities?search=${encodeURIComponent(query.trim())}`)
      .then(r=>{if(request.current===id){setCities(r.cities||[]);setError('');}})
      .catch(e=>{if(request.current===id)setError(errString(e));}),380);
    return ()=>clearTimeout(timer);
  },[query,stage]);

  useEffect(()=>{
    if(stage!=='explore'||tab!=='itinerary'||!start)return;
    for(let day=1;day<=days;day++){
      const applied=appliedServiceSearch[day];
      const date=applied?.date||recommendedTripDate(day);
      const clock=applied?.time||'09:30';
      if(!validDate(date)||!/^([01]\d|2[0-3]):[0-5]\d$/.test(clock))continue;
      let departureMs=new Date(`${date}T${clock}:00`).getTime();
      for(const leg of itineraryLegs(day)){
        const cached=legCache[leg.key];
        if(cached){
          const selected=cached.options.find(o=>o.id===cached.selected);
          // Without a known arrival (for instance, a taxi) there is no
          // responsible way to infer the next stop's departure time.
          if(!selected||taxiChoices[leg.key])break;
          const arrivalMs=selected.end?Date.parse(selected.end):NaN;
          departureMs=Number.isFinite(arrivalMs)&&arrivalMs>=departureMs
            ?arrivalMs:departureMs+selected.minutes*60000;
          departureMs+=(visitTime(leg.to as Place)+15)*60000;
          continue;
        }
        const version=serviceSearchVersion.current[day]||0;
        const pendingKey=`${leg.key}:service:${version}`;
        if(pendingRoutes.current.has(pendingKey))break;
        pendingRoutes.current.add(pendingKey);
        const searchedAt=new Date(departureMs).toISOString();
        void (async()=>{
          let options:Option[]=[];
          let routeError='';
          let nextAvailable=false;
          try{
            const result=await api<any>(`/api/transport/journey?${params({
              from_lat:leg.from.latitude,
              from_lon:leg.from.longitude,
              to_lat:leg.to.latitude,
              to_lon:leg.to.longitude,
              // Keep the journey option cap compatible with the MileMosaic backend's
              // existing validation (V5.2 successfully requested limit=10).
              datetime:searchedAt,limit:10
            })}`);
            options=parseOptions(result);
            nextAvailable=result?.data?.next_available===true;
          }catch(e){routeError=errString(e);}
          if(version===serviceSearchVersion.current[day]){
            setLegCache(prev=>({
              ...prev,
              [leg.key]:{
                from:leg.from,to:leg.to,options,
                best:options[0]?.id||'',
                selected:options[0]?.id||'',routeError,searchedAt,nextAvailable
              }
            }));
          }
          pendingRoutes.current.delete(pendingKey);
        })();
        // Sequentially search the next stop after this journey arrives,
        // instead of incorrectly searching all day legs from 09:30.
        break;
      }
    }
  },[stage,tab,plan,hotelChoice,hotelAfter,foodChoice,foodAfter,start,days,legCache,
     appliedServiceSearch,serviceSearchRevision,taxiChoices,visitLengths]);

  function chooseCity(c:City){
    request.current++;routeRequest.current++;priceRequest.current++;
    setCity(c);setCities([]);setQuery(c.name);setStage('start');Keyboard.dismiss();
    setStartChoice({name:`${c.name} city centre`,latitude:c.latitude,longitude:c.longitude});
    setPin(null);setLocationResults([]);setStartInput('');setStops([]);setError('');
    setAttractions([]);setFood([]);setHotels([]);setPlan({});setHotelChoice(null);setHotelPrices({});
    photoCitySession.current++;
    requestedPhotos.current.clear();
    businessPhotoChecked.current.clear();
    businessPhotoResults.current.clear();
    businessPhotoLoading.current=false;
    setBusinessPhotoStatus('');
    setOnlinePhotoStatus('');
    setStart(null);setFocus(null);setJourney(null);
    setLegCache({});setHotelAfter(null);setDayDates({});
    setExpandedServiceModes({});setAppliedServiceSearch({});
    serviceSearchVersion.current={};
    setDayStarts({});setVisitLengths({});setPhotoStatus('');
    setLandmarkResults(null);setSearchedLandmark('');setLandmarkInput('');cache.current.clear();
    Promise.allSettled([
      api<any>(`/api/transport/stops?${params({lat:c.latitude,lon:c.longitude,radius:4000,limit:10})}`),
      api<any>(`/api/transport/rail/stations?${params({lat:c.latitude,lon:c.longitude,radius:10000,limit:8})}`),
    ]).then(values=>{
      const suggestions:Location[]=[];
      for(const v of values){if(v.status!=='fulfilled')continue;
        for(const raw of v.value.data?.member||[]){const p=raw as Record<string,unknown>;
          if(!coordOK(p))continue;
          const row=p as Record<string,any> & Coord;
          if(typeof row.name==='string'&&!suggestions.some(x=>x.name===row.name))
          suggestions.push({name:row.name,latitude:Number(row.latitude),longitude:Number(row.longitude),category:String(row.type||'Stop')});}
      }
      setStops(suggestions.slice(0,10));
    });
  }
  async function findDestination(){
    if(query.trim().length<2){setError('Enter at least 2 letters');return;}
    try{setBusy(true);setError('');const r=await api<{cities:City[]}>(`/api/cities?search=${encodeURIComponent(query.trim())}`);
      const exact=r.cities.find(c=>c.name.toLowerCase()===query.trim().toLowerCase());
      if(exact||r.cities.length===1)chooseCity(exact||r.cities[0]);
      else if(r.cities.length)setCities(r.cities);
      else setError('City not found. Try a different spelling.');
    }catch(e){setError(errString(e));}finally{setBusy(false);}
  }
  async function searchStartingLocation(){
    const typed=startInput.trim();
    if(typed.length<3){setError('Type an airport or station name, such as Gatwick Airport.');return;}
    const centre=city&&`${city.name} city centre`.toLowerCase();
    if(city&&[centre,`${city.name} city center`.toLowerCase(),'city centre','city center'].includes(typed.toLowerCase())){
      setStartChoice({name:`${city.name} city centre`,latitude:city.latitude,longitude:city.longitude});
      setLocationResults([]);setError('');Keyboard.dismiss();return;
    }
    try{setLocationBusy(true);setError('');const r=await findUKStart(typed);
      setLocationResults(r);if(!r.length)setError('No matching UK airport or transport station found. Try the full name (e.g. Gatwick Airport), or select a map pin.');
    }catch(e){setError(errString(e));}finally{setLocationBusy(false);}
  }

  async function explore(){
    if(!city||!startChoice){
      setError('Please select a starting point.');
      return;
    }

    setStart(startChoice);
    setStage('explore');
    setPrefs(true);
    setTab('attractions');
    setError('');
    setShowMore(false);
    setLandmarkResults(null);

    const anchor=attractionOrigin(city,startChoice);
    const id=++request.current;

    setBusy(true);
    setPhotoStatus('Searching the full 3 km area…');

    try{
      const osm=await discoverWideOSM(anchor);

      if(id!==request.current)return;

      setAttractions(osm);

      setPhotoStatus(
        `Found ${osm.length} OSM records. Loading landmark photos…`
      );

      discoverWideWiki(anchor).then(wiki=>{
        if(id!==request.current)return;

        setAttractions(prev=>{
          const saved=new Map(
            prev.filter(p=>p.image).map(p=>[p.id,p])
          );

          return combineAttractions(osm,wiki).map(p=>{
            const old=saved.get(p.id);

            return !p.image&&old?.image
              ?{
                ...p,
                image:old.image,
                imagePage:old.imagePage
              }
              :p;
          });
        });

        setPhotoStatus(
          wiki.length
            ? '3 km discovery · OSM + Wikipedia'
            : '3 km discovery · OSM results available'
        );
      }).catch(()=>{
        if(id===request.current){
          setPhotoStatus(
            'OSM attractions loaded; Wikipedia unavailable.'
          );
        }
      });

    }catch(e){
      if(id===request.current)setError(errString(e));
    }finally{
      if(id===request.current)setBusy(false);
    }
  }

  async function searchLandmark(){
    if(!city||landmarkInput.trim().length<2)return;
    const term=landmarkInput.trim();
    try{
      setBusy(true);setError('');
      // Both searches are live Wikipedia queries, not a hardcoded landmark list.
      const [exactResult,fulltextResult]=await Promise.allSettled([
        wikipediaExactTitle(
          term,attractionOrigin(city,startChoice)
        ),wikipediaSearch(
          term,attractionOrigin(city,startChoice)
        ),
      ]);
      if(exactResult.status==='rejected'&&fulltextResult.status==='rejected'){
        throw new Error('Wikipedia landmark search unavailable. Try again later.');
      }
      const exact=exactResult.status==='fulfilled'?exactResult.value:[];
      const fulltext=fulltextResult.status==='fulfilled'?fulltextResult.value:[];
      const unique=[...new Map([...exact,...fulltext].map(p=>[p.id,p])).values()];
      const query=term.toLowerCase();
      unique.sort((a,b)=>{
        const rank=(name:string)=>{
          const t=name.toLowerCase();
          return t===query?0:t.startsWith(query)?1:t.includes(query)?2:3;
        };
        return rank(a.name)-rank(b.name)||haversine(city,a)-haversine(city,b);
      });
      // Search displays ONLY these matches, rather than burying them under
      // the existing type-ranked 3-km attraction recommendations.
      setLandmarkResults(unique);
      setSearchedLandmark(term);
      if(unique.length){
        setAttractions(prev=>[...unique.filter(m=>!prev.some(p=>p.id===m.id)),...prev]);
      }else{
        setError(`No Wikipedia landmark called "${term}" with coordinates within 3 km of ${city.name} centre.`);
      }
      Keyboard.dismiss();
    }catch(e){setError(errString(e));setLandmarkResults([]);setSearchedLandmark(term);}
    finally{setBusy(false);}
  }
  async function fillBusinessPhotos(rows:Place[],includeExisting=false){
    if(businessPhotoLoading.current)return;
    const pending=rows.filter(p=>p.kind!=='attraction'&&
      (includeExisting||!p.image)&&
      !businessPhotoChecked.current.has(p.id)).slice(0,12);
    if(!pending.length)return;
    businessPhotoLoading.current=true;
    pending.forEach(p=>businessPhotoChecked.current.add(p.id));
    const session=photoCitySession.current;
    setBusinessPhotoStatus(`Looking for matching venue/brand photos (${pending.length})…`);
    try{
      const result=await lookupBusinessPhotos(pending);
      const found=result.found;
      if(session!==photoCitySession.current)return;
      for(const [placeId,photo] of Object.entries(found)){
        businessPhotoResults.current.set(placeId,photo);
      }
      if(Object.keys(found).length){
        const apply=(p:Place)=>found[p.id]?{...p,...found[p.id]}:p;
        setFood(old=>old.map(apply));
        setHotels(old=>old.map(apply));
        setFoodChoice(old=>old?apply(old):old);
        setHotelChoice(old=>old?apply(old):old);
        setPlan(old=>Object.fromEntries(Object.entries(old).map(
          ([day,items])=>[day,items.map(apply)])));
        for(const [key,items] of cache.current){
          cache.current.set(key,items.map(apply));
        }
      }
      const count=Object.keys(found).length;
      const notes=Object.values(found).filter(p=>p.imageNote?.startsWith('Brand/article')).length;
      console.log('[MileMosaic business images detail]',
        'looked up:',pending.map(p=>p.name).join(', '),
        '| photos:',Object.keys(found).length,
        '| errors:',result.errors.join(' | ')||'none');
      if(!count&&result.errors.length){
        // Failed provider requests should remain manually retryable.
        pending.forEach(p=>businessPhotoChecked.current.delete(p.id));
        setBusinessPhotoStatus(
          `No photos retrieved; Wikimedia request failed: ${result.errors[0]}. `+
          'Use the retry button after checking the connection.'
        );
      }else{
        // If Commons returned "too busy", permit a LATER user-initiated retry
        // for missing images rather than marking them permanently checked.
        if(result.errors.length){
          pending.filter(p=>!found[p.id]).forEach(p=>businessPhotoChecked.current.delete(p.id));
        }
        setBusinessPhotoStatus(
          `${count} images found for ${pending.length} places`+
          (notes?` (${notes} brand/article illustrations, not branch photos)`:'')+
          (result.errors.length?`. Wikimedia was busy; retry missing photos later. ${result.errors[0]}`:
            '. Remaining venues have no confidently matched photo in these sources.')
        );
      }
    }catch(e){
      if(session!==photoCitySession.current)return;
      pending.forEach(p=>businessPhotoChecked.current.delete(p.id));
      setBusinessPhotoStatus('Venue photo lookup unavailable: '+errString(e));
    }finally{
      if(session===photoCitySession.current)businessPhotoLoading.current=false;
    }
  }
  function checkMoreBusinessPhotos(kind:'food'|'hotels'){
    const collection=kind==='food'?food:hotels;
    const remaining=collection.filter(p=>!p.image&&
      !businessPhotoChecked.current.has(p.id));
    if(!remaining.length){
      setBusinessPhotoStatus('All currently listed venues were checked. Some businesses have no usable Wikimedia image; we will not invent a branch photo.');
      return;
    }
    void fillBusinessPhotos(remaining);
  }
  function failedBusinessPhoto(p:Place){
    // Do not retry a Wikimedia 403 using more Wikimedia URLs automatically.
    if(/\.wikimedia\.org\//.test(p.image||''))return;
    void fillBusinessPhotos([p],true);
  }
  async function discover(kind:'food'|'hotels',near:Place|null=null){
    if(!city)return;
    const coords=near||city;
    const key=[city.name,kind,coords.latitude.toFixed(4),coords.longitude.toFixed(4)].join(':');
    const id=++request.current;setTab(kind);setFocus(near);setError('');setBusy(true);setJourney(null);
    setBusinessPhotoStatus('');
    try{
      let rows=cache.current.get(key);
      if(!rows){if(kind==='food'){
          const data=await api<{places:any[]}>(`/api/nearby?${params({lat:coords.latitude,lon:coords.longitude,radius:near?2600:6500,limit:50,type:'restaurant'})}`);
          rows=(data.places||[]).filter(p=>p.name&&coordOK(p)).map(p=>placeFromOSM(p,'restaurant'));
        }else{
          const data=await api<{hotels:any[];osm_only:any[]}>(`/api/hotels/matched?${params({city:city.name,lat:coords.latitude,lon:coords.longitude,radius:near?4000:8000,limit:16,pages:2})}`);
          rows=[...(data.hotels||[]).map(hotelFromX),...(data.osm_only||[]).filter(p=>p.name&&coordOK(p)).map(p=>placeFromOSM(p,'hotel'))];
        }cache.current.set(key,rows);
      }
      if(id===request.current){
        const withPhoto=rows.map(p=>businessPhotoResults.current.has(p.id)
          ?{...p,...businessPhotoResults.current.get(p.id)!}:p);
        kind==='food'?setFood(withPhoto):setHotels(withPhoto);
        void fillBusinessPhotos(withPhoto);
      }
    }catch(e){if(id===request.current)setError(errString(e));}finally{if(id===request.current)setBusy(false);}
  }
  function toggle(place:Place){
    if(place.kind==='restaurant' && foodAfter){
      setFoodChoice(old=>old?.id===place.id?null:place);
      setLegCache({});
      setTab('itinerary');
      screenScroll.current?.scrollTo({y:300,animated:true});
      return;
    }

    if(place.kind==='hotel'){
      if(hotelChoice?.id===place.id){
        priceRequest.current++;
        setHotelChoice(null);
        setPricedFor('');
        setPriceError('');
      }else{
        void loadHotelPrices(place);
      }
      setLegCache({});setJourney(null);
      return;
    }
    setLegCache({});setPlan(prev=>{const items=prev[activeDay]||[];return {...prev,[activeDay]:items.some(p=>p.id===place.id)
      ?items.filter(p=>p.id!==place.id):[...items,place]};});setJourney(null);
  }
  async function loadHotelPrices(hotel:Place){
    const dates=tonight();
    setHotelChoice(hotel);
    setPriceError('');

    const id=++priceRequest.current;
    setPricedFor(dates.start);
    setHotelPrices(old=>({...old,[hotel.id]:[]}));

    if(!hotel.hotelKey){
      setQuoteBusy(false);
      setPriceError('Xotelo price unavailable for this hotel.');
      return;
    }

    setQuoteBusy(true);

    try{
      const r=await api<any>(
        `/api/hotels/xotelo/rates?${params({
          hotel_key:hotel.hotelKey,
          chk_in:dates.start,
          chk_out:dates.end,
          currency:'GBP',
          rooms:1,
          adults:2
        })}`
      );

      const rates:Rate[]=(r.data?.result?.rates||[])
        .filter((x:any)=>
          typeof x.rate==='number' &&
          Number.isFinite(x.rate) &&
          x.rate>0
        )
        .sort((a:Rate,b:Rate)=>a.rate-b.rate);

      if(id===priceRequest.current){
        setHotelPrices(old=>({...old,[hotel.id]:rates}));

        if(!rates.length){
          setPriceError('Tonight price unavailable.');
        }
      }
    }catch(e){
      if(id===priceRequest.current){
        setPriceError(errString(e));
      }
    }finally{
      if(id===priceRequest.current){
        setQuoteBusy(false);
      }
    }
  }
  const dayItems=plan[activeDay]||[];
  const allDays=Array.from({length:days},(_,i)=>({day:i+1,places:plan[i+1]||[]}));
  const selectedCount=allDays.reduce((n,d)=>n+d.places.length,0);
  const knownManualCost=allDays.reduce((acc,d)=>acc+d.places.reduce((s,p)=>{
    const raw=manualCosts[`${d.day}:${p.id}`];const value=Number(raw);
    return s+(raw?.trim()&&Number.isFinite(value)&&value>=0?value:0);},0),0);
  const hotelQuote=hotelChoice&&pricedFor===tonight().start
    ?hotelPrices[hotelChoice.id]?.[0]
    :undefined;
  const nights=1;
  const knownTransport=Array.from(
    {length:days},(_,i)=>i+1
  ).flatMap(day=>itineraryLegs(day)).reduce((sum,leg)=>{
    const route=legCache[leg.key];
    const selected=route?.options.find(
      o=>o.id===route.selected
    );

    return sum+(!taxiChoices[leg.key] &&
      selected?.complete &&
      selected.fare!==null &&
      selected.fare!==undefined
        ?selected.fare
        :0
    );
  },0);

  const knownTotal=
    knownManualCost+
    (hotelQuote&&nights?hotelQuote.rate*nights:0)+
    knownTransport;
  const missingCost=allDays.reduce((n,d)=>n+d.places.filter(p=>
    !/^\d+(\.\d{1,2})?$/.test(manualCosts[`${d.day}:${p.id}`]||'')).length,0)+(hotelChoice&&!hotelQuote?1:0);
  const cuisines=['All','Indian','Italian','Chinese','British','Asian','Pizza','Fast food','Other'];
  const visibleFood=food.filter(p=>{
    const value=(p.cuisine||'').toLowerCase();
    if(cuisine!=='All'&&(cuisine==='Other'?(!value||cuisines.slice(1,-1).some(c=>value.includes(c.toLowerCase()))):!value.includes(cuisine.toLowerCase())))return false;
    if(diet==='Vegetarian'&&!['yes','only'].includes((p.vegetarian||'').toLowerCase())&&
       !['yes','only'].includes((p.vegan||'').toLowerCase()))return false;
    if(diet==='Vegan'&&!['yes','only'].includes((p.vegan||'').toLowerCase()))return false;
    return true;
  });

  const rankedAttractions=useMemo(()=>{
    const origin=city?attractionOrigin(city,start):null;

    const score=(place:Place)=>{
      const category=place.category.toLowerCase();

      let points=
        /castle|museum|gallery|palace|aquarium|zoo/.test(category)
          ?85:
        /attraction|historic|viewpoint|heritage/.test(category)
          ?78:
        /monument/.test(category)
          ?48:
        /memorial|statue|sculpture|artwork/.test(category)
          ?28:
        place.imagePage?66:50;

      if(place.image)points+=8;
      if(origin)points-=haversine(origin,place)/450;

      return points;
    };

    const ordered=[...attractions].sort(
      (a,b)=>score(b)-score(a)
    );

    const unique:Place[]=[];

    for(const p of ordered){
      if(unique.some(q=>
        normal(p.name)===normal(q.name)&&
        haversine(p,q)<180
      ))continue;

      unique.push(p);
    }

    const featured:Place[]=[];
    const remaining:Place[]=[];

    for(const p of unique){
      // Prevent all featured results coming
      // from the same few metres.
      if(
        featured.length<12 &&
        !featured.some(q=>haversine(p,q)<450)
      ){
        featured.push(p);
      }else{
        remaining.push(p);
      }
    }

    return [...featured,...remaining];

  },[attractions,city,start]);
  useEffect(()=>{
    if(stage!=='explore'||tab!=='attractions')return;

    const visible=landmarkResults!==null
      ?landmarkResults.slice(0,24)
      :(
        showMore
          ?rankedAttractions.slice(0,36)
          :rankedAttractions.slice(0,12)
      );

    const todo=visible.filter(p=>
      p.kind==='attraction'&&
      !p.image&&
      !requestedPhotos.current.has(p.id)
    ).slice(0,12);

    if(!todo.length)return;

    todo.forEach(p=>
      requestedPhotos.current.add(p.id)
    );

    const session=photoCitySession.current;

    setOnlinePhotoStatus(
      `Checking online photos for ${todo.length} attractions…`
    );

    void wikiOnlineImages(todo).then(found=>{
      if(session!==photoCitySession.current)return;

      const count=Object.keys(found).length;

      if(count){
        const enhance=(p:Place)=>
          found[p.id]?{...p,...found[p.id]}:p;

        setAttractions(prev=>prev.map(enhance));

        setLandmarkResults(prev=>
          prev===null?null:prev.map(enhance)
        );

        setPlan(prev=>
          Object.fromEntries(
            Object.entries(prev).map(([day,places])=>[
              day,
              places.map(enhance)
            ])
          )
        );
      }

      setOnlinePhotoStatus(
        `${count} photo URLs found for ${todo.length} attractions.`
      );

    }).catch(e=>{
      if(session!==photoCitySession.current)return;

      todo.forEach(p=>
        requestedPhotos.current.delete(p.id)
      );

      setOnlinePhotoStatus(
        'Online image request failed: '+errString(e)
      );

      console.warn(
        '[MileMosaic Wikipedia photos]',
        e
      );
    });

  },[
    stage,
    tab,
    landmarkResults,
    rankedAttractions,
    showMore,
    photoRetry
  ]);

  const displayed=tab==='attractions'?(landmarkResults!==null?landmarkResults:(showMore?rankedAttractions:rankedAttractions.slice(0,12))):
    tab==='food'?visibleFood:tab==='hotels'?hotels:[];
  const currentMap=focus||city;
  const selectedOption=journey?.options.find(o=>o.id===journey.selected)||null;
  const linePaths=renderRouteCoords(selectedOption);


  function dayStops(day:number):Place[]{
    const output:Place[]=[];
    for(const place of plan[day]||[]){
      output.push(place);
      if(foodChoice&&foodAfter?.day===day&&foodAfter.id===place.id)
        output.push(foodChoice);
      if(hotelChoice&&hotelAfter?.day===day&&hotelAfter.id===place.id)
        output.push(hotelChoice);
    }
    return output;
  }

  function itineraryLegs(day:number){
    const stops=dayStops(day);
    const previous=day>1?dayStops(day-1):[];
    const from=day===1
      ?start
      :(hotelChoice||previous[previous.length-1]||start);

    const points:Location[]=[
      ...(from?[from]:[]),
      ...stops
    ];

    return points.slice(1).map((to,i)=>({
      from:points[i],
      to,
      key:`day:${day}:${points[i].latitude.toFixed(5)},${points[i].longitude.toFixed(5)}:${to.latitude.toFixed(5)},${to.longitude.toFixed(5)}`
    }));
  }

  const getDate=(day:number)=>
    dayDates[day]||recommendedTripDate(day);

  const getStartTime=(day:number)=>
    dayStarts[day]||'09:30';

  const validClock=(s:string)=>
    /^([01]\d|2[0-3]):[0-5]\d$/.test(s);

  const visitTime=(p:Place)=>{
    const value=Number(visitLengths[p.id]);
    return visitLengths[p.id]!==undefined &&
      Number.isInteger(value) &&
      value>=10 && value<=360
      ?value
      :(p.kind==='hotel'?20:60);
  };

  function timeLabel(min:number){
    return `${String(Math.floor(min/60)%24).padStart(2,'0')}:${String(min%60).padStart(2,'0')}`;
  }

  function timeline(day:number){
    const hhmm=getStartTime(day);
    const valid=validClock(hhmm);
    let minute=valid
      ?Number(hhmm.slice(0,2))*60+Number(hhmm.slice(3))
      :0;

    let known=valid;
    const legs=itineraryLegs(day);

    return dayStops(day).map((place,i)=>{
      const route=legCache[legs[i]?.key];
      const selected=route?.options.find(
        o=>o.id===route.selected
      );

      if(!selected)known=false;
      if(known)minute+=selected!.minutes;

      const arrival=known
        ?timeLabel(minute)
        :'ETA pending';

      if(known)minute+=visitTime(place)+15;

      return {
        place,
        arrival,
        duration:visitTime(place)
      };
    });
  }

  function moveStop(day:number,index:number,delta:number){
    setPlan(prev=>{
      const items=[...(prev[day]||[])];
      const target=index+delta;

      if(target<0||target>=items.length)return prev;

      [items[index],items[target]]=[
        items[target],items[index]
      ];

      return {...prev,[day]:items};
    });

    setLegCache({});
    setJourney(null);
  }

  function setHotelWaypoint(day:number,id:string){
    setHotelAfter({day,id});
    setLegCache({});
    setJourney(null);
  }

  function formatTripDatetime(day:number,minutes:number){
    const date=getDate(day);

    if(!validDate(date))
      throw new Error('Enter valid date YYYY-MM-DD');

    const base=new Date(`${date}T00:00:00`);
    base.setMinutes(minutes);

    return base.toISOString();
  }

  function parseOptions(raw:any):Option[]{
    const body=raw?.data||{};

    const options:Option[]=[
      ...(body.itineraries||[]).map(
        (x:Itinerary,i:number)=>optionFrom(x,i,'transit')
      ),
      ...(body.alternatives?.walk?.itineraries||[]).map(
        (x:Itinerary,i:number)=>optionFrom(x,i,'walk')
      ),
      ...(body.alternatives?.bicycle?.itineraries||[]).map(
        (x:Itinerary,i:number)=>optionFrom(x,i,'bicycle')
      )
    ].filter(o=>Number.isFinite(o.minutes)&&o.minutes>0);

    return options.sort((a,b)=>a.minutes-b.minutes);
  }

  function dayMapRegion(day:number){
    const legs=itineraryLegs(day);
    const points=[
      ...legs.map(l=>l.from),
      ...legs.map(l=>l.to)
    ];

    if(!points.length&&city)points.push(city);

    const lats=points.map(x=>x.latitude);
    const lons=points.map(x=>x.longitude);
    const minLat=Math.min(...lats);
    const maxLat=Math.max(...lats);
    const minLon=Math.min(...lons);
    const maxLon=Math.max(...lons);

    return {
      latitude:(minLat+maxLat)/2,
      longitude:(minLon+maxLon)/2,
      latitudeDelta:Math.min(
        12,Math.max(.03,(maxLat-minLat)*1.6)
      ),
      longitudeDelta:Math.min(
        12,Math.max(.03,(maxLon-minLon)*1.6)
      )
    };
  }

  // Apply a day/time only when the traveller taps Search. Stale requests
  // cannot overwrite refreshed service options for this day.
  function searchDayServices(day:number){
    const date=getDate(day),time=getStartTime(day);
    if(!validDate(date)||!validClock(time)){
      setError('Use a valid date YYYY-MM-DD and departure time HH:MM.');
      return;
    }
    setError('');
    serviceSearchVersion.current[day]=(serviceSearchVersion.current[day]||0)+1;
    setAppliedServiceSearch(prev=>({...prev,[day]:{date,time}}));
    setExpandedServiceModes(prev=>Object.fromEntries(Object.entries(prev)
      .filter(([key])=>!key.startsWith(`day:${day}:`))));
    setLegCache(prev=>Object.fromEntries(Object.entries(prev)
      .filter(([key])=>!key.startsWith(`day:${day}:`))));
    setServiceSearchRevision(x=>x+1);
  }

  function clearFollowingServiceRoutes(key:string){
    const match=key.match(/^day:(\d+):/);
    if(!match)return;
    const day=Number(match[1]);
    const legs=itineraryLegs(day);
    const index=legs.findIndex(leg=>leg.key===key);
    if(index<0)return;
    serviceSearchVersion.current[day]=(serviceSearchVersion.current[day]||0)+1;
    const later=new Set(legs.slice(index+1).map(leg=>leg.key));
    setLegCache(prev=>Object.fromEntries(Object.entries(prev)
      .filter(([k])=>!later.has(k))));
  }

  function selectDayService(key:string,selectedId:string){
    const previous=legCache[key];
    setTaxiChoices(prev=>({...prev,[key]:false}));
    if(previous?.selected!==selectedId||taxiChoices[key]){
      clearFollowingServiceRoutes(key);
    }
    setLegCache(prev=>{
      const current=prev[key];
      return current?{...prev,[key]:{...current,selected:selectedId}}:prev;
    });
    setActiveLegKey('');
  }

  async function calculateDay(day:number){
    const time=getStartTime(day);

    if(!validClock(time)||!validDate(getDate(day))){
      setError('Enter date YYYY-MM-DD and start HH:MM');
      return;
    }

    const legs=itineraryLegs(day);

    if(!legs.length){
      setError('Add attractions first.');
      return;
    }

    setError('');
    setRoutingDay(day);
    setJourney(null);
    routeRequest.current++;

    setLegCache(prev=>Object.fromEntries(
      Object.entries(prev).filter(
        ([key])=>!key.startsWith(`day:${day}:`)
      )
    ));

    let minute=
      Number(time.slice(0,2))*60+
      Number(time.slice(3));

    try{
      for(const leg of legs){
        const datetime=formatTripDatetime(day,minute);
        let options:Option[]=[];
        let routeError='';

        try{
          const response=await api<any>(
            `/api/transport/journey?${params({
              from_lat:leg.from.latitude,
              from_lon:leg.from.longitude,
              to_lat:leg.to.latitude,
              to_lon:leg.to.longitude,
              datetime,
              limit:10
            })}`
          );

          options=parseOptions(response);
        }catch(e){
          routeError=errString(e);
        }

        const best=options[0]?.id||'';

        const result:Journey={
          from:leg.from,
          to:leg.to,
          options,
          best,
          selected:best,
          routeError
        };

        setLegCache(prev=>({
          ...prev,
          [leg.key]:result
        }));

        if(!options.length)break;

        minute+=
          options[0].minutes+
          visitTime(leg.to as Place)+15;
      }
    }finally{
      setRoutingDay(null);
    }
  }

  async function compareRoute(
    from:Location,
    to:Location,
    key:string
  ){
    const id=++routeRequest.current;
    setActiveLegKey(key);
    setJourneyBusy(true);
    setJourney(null);
    setError('');

    try{
      const match=key.match(/^day:(\d+):/);
      const day=match?Number(match[1]):1;
      const start=getStartTime(day);

      const datetime=formatTripDatetime(
        day,
        Number(start.slice(0,2))*60+
        Number(start.slice(3))
      );

      const response=await api<any>(
        `/api/transport/journey?${params({
          from_lat:from.latitude,
          from_lon:from.longitude,
          to_lat:to.latitude,
          to_lon:to.longitude,
          datetime,
          limit:10
        })}`
      );

      const options=parseOptions(response);
      const best=options[0]?.id||'';

      if(id===routeRequest.current){
        setJourney({
          from,to,options,best,selected:best
        });
      }
    }catch(e){
      if(id===routeRequest.current){
        setJourney({
          from,to,options:[],best:'',
          selected:'',routeError:errString(e)
        });
      }
    }finally{
      if(id===routeRequest.current)setJourneyBusy(false);
    }
  }

  async function openDirections(opt:Option){
    if(!journey)return;

    const origin=
      `${journey.from.latitude},${journey.from.longitude}`;

    const destination=
      `${journey.to.latitude},${journey.to.longitude}`;

    const url=
      `https://www.google.com/maps/dir/?${params({
        api:1,
        origin,
        destination,
        travelmode:GoogleMode(opt)
      })}`;

    try{
      await Linking.openURL(url);
    }catch{
      Alert.alert(
        'Directions unavailable',
        'Could not open Google Maps.'
      );
    }
  }
  function placeCard(place:Place){
    const picked=place.kind==='hotel'?hotelChoice?.id===place.id:dayItems.some(p=>p.id===place.id);
    const isHotel=place.kind==='hotel';
    const match=place.match==='confirmed'?'Confirmed algorithmic match':place.match==='possible'? 'Attention required · unverified match':
      isHotel?'Cross-source information unavailable':'';
    const rates=hotelPrices[place.id];
    const hotelOpen=isHotel&&hotelChoice?.id===place.id;
    return <View key={place.id} style={s.placeCard}>
      <PlacePhoto place={place} onPhotoFailed={failedBusinessPhoto}/>
      <Text style={s.placeName}>{place.name}</Text>
      <Text style={s.muted}>{place.category.replace(/_/g,' ')}{Number.isFinite(place.distance)?` · ${Math.round(place.distance!)}m away`:''}
        {place.rating?` · ★ ${place.rating.toFixed(1)}`:''}</Text>
      {place.imagePage&&<Pressable onPress={()=>void Linking.openURL(place.imagePage!)}>
        <Text style={s.tinyLink}>Photo source ↗{place.imageCredit?` · ${place.imageCredit}`:''}
          {place.imageLicense?` · ${place.imageLicense}`:' · Check image licence and attribution'}</Text></Pressable>}
      {!!place.imageNote&&<Text style={s.caption}>{place.imageNote}</Text>}
      {!!place.imageLicenseUrl&&<Pressable onPress={()=>void Linking.openURL(place.imageLicenseUrl!)}>
        <Text style={s.tinyLink}>View image licence ↗</Text></Pressable>}
      {isHotel?<Badge value={match} kind={place.match==='confirmed'?'good':place.match==='possible'?'warn':'neutral'}/>:
        place.kind==='restaurant'?<Text style={s.caption}>Cuisine: {place.cuisine||'Not tagged'} · Diet: {place.vegetarian||place.vegan||'Not verified'} · Menu price unavailable</Text>:
        <Text style={s.caption}>{place.openingHours?`OSM hours: ${place.openingHours}`:'Opening hours not verified'} · Ticket price unavailable</Text>}
      <View style={s.buttonRow}>
        <AppButton title={picked?isHotel?'✓ Chosen stay':'✓ Remove':isHotel?'🏨 Select / See prices':`＋ Add to Day ${activeDay}`}
          onPress={()=>toggle(place)}/>
        <AppButton title="Directions ↗" light onPress={()=>{
          const origin=start||city;
          if(origin)void compareRoute(origin,place,`card:${place.id}`);
          setTab('itinerary');
        }}/>
      </View>
      {place.kind==='attraction'&&<View style={s.inlineLinks}>
        <Pressable onPress={()=>void discover('hotels',place)}><Text style={s.link}>🏨 Get hotels nearby</Text></Pressable>
        <Pressable onPress={()=>void discover('food',place)}><Text style={s.link}>🍽 Get food nearby</Text></Pressable>
      </View>}
      {hotelOpen&&<View style={s.inlinePrice}>
        <Text style={s.cardLabel}>
          TONIGHT · 1 ROOM / 2 ADULTS
        </Text>

        <Text style={s.muted}>
          {tonight().start} → {tonight().end}
        </Text>

        {quoteBusy&&<ActivityIndicator color={P.teal}/>}

        {!!priceError&&
          <Text style={s.errorText}>{priceError}</Text>
        }

        {!!rates?.length&&pricedFor===tonight().start&&<>
          <Text style={s.goodText}>
            From {money(rates[0].rate)} for 1 night
          </Text>

          {rates.slice(0,4).map((r,i)=>
            <Text key={i} style={s.muted}>
              {r.name}: {money(r.rate)}
            </Text>
          )}
        </>}

        <Text style={s.caption}>
          Indicative quote. Taxes or fees may vary.
          No booking made.
        </Text>
      </View>}
    </View>;
  }
  function routePanel(){
    if(journeyBusy)return <View style={s.routeBox}><ActivityIndicator color={P.teal}/><Text style={s.muted}>Comparing public transport and other modes…</Text></View>;
    if(!journey)return null;
    return <View style={s.routeBox}>
      <Text style={s.cardLabel}>ROUTE COMPARISON · LIVE PROVIDER DATA WHEN AVAILABLE</Text>
      <Text style={s.placeName}>{journey.from.name} → {journey.to.name}</Text>
      {!!journey.routeError&&<Text style={s.errorText}>{journey.routeError}</Text>}
      {!journey.options.length&&<Text style={s.caption}>No routes returned. Try another time/location; no timings were invented.</Text>}
      {journey.options.map(o=><View key={o.id} style={[s.optionRow,journey.selected===o.id&&{borderColor:P.teal,backgroundColor:P.mint}]}>
        <Pressable style={{flex:1}} onPress={()=>setJourney(v=>v?{...v,selected:o.id}:v)}>
          <Text style={s.placeName}>{o.icon} {o.label} · {o.minutes} min {journey.best===o.id?' · FASTEST':''}{o.fare!==null&&o.complete&&o.fare===Math.min(...journey.options.filter(x=>x.fare!==null&&x.complete).map(x=>x.fare as number))?' · LOWEST KNOWN FARE':''}</Text>
          <Text style={s.caption}>{o.fare===null?'Fare not available':o.complete?money(o.fare):`${money(o.fare)} (partial fare)`}
            {' · '}{o.transfers} change(s){o.start?` · departs ${new Date(o.start).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}`:''}</Text>
        </Pressable>
        <Pressable onPress={()=>setJourney(v=>v?{...v,selected:o.id}:v)}><Text style={s.link}>View</Text></Pressable>
      </View>)}
      {selectedOption&&<View style={{marginTop:12}}>
        <MapView key={`${journey.from.name}:${journey.to.name}:${selectedOption.id}`} provider={PROVIDER_GOOGLE}
          style={s.routeMap} initialRegion={{latitude:(journey.from.latitude+journey.to.latitude)/2,
          longitude:(journey.from.longitude+journey.to.longitude)/2,
          latitudeDelta:Math.max(.015,Math.abs(journey.from.latitude-journey.to.latitude)*1.5),
          longitudeDelta:Math.max(.015,Math.abs(journey.from.longitude-journey.to.longitude)*1.5)}}>
          <Marker coordinate={journey.from} title={journey.from.name} pinColor={P.teal}/>
          <Marker coordinate={journey.to} title={journey.to.name} pinColor={P.purple}/>
          {renderRouteCoords(selectedOption).map((coords,i)=><Polyline key={i} coordinates={coords} strokeColor={P.teal} strokeWidth={5}/>)}
        </MapView>
        <Text style={s.caption}>Only provider-supplied route geometry is drawn; missing segments are not invented.</Text>
        <Text style={s.cardLabel}>DIRECTIONS FOR SELECTED OPTION</Text>
        {selectedOption.legs.length?selectedOption.legs.map((l,i)=><View key={`${selectedOption.id}:${i}`} style={s.stepRow}>
          <Text style={s.stepNumber}>{i+1}</Text>
          <View style={{flex:1}}><Text style={s.placeName}>{legMode(l)||selectedOption.label}
            {l.route?.line?` ${l.route.line}`:l.route?.short_name?` ${l.route.short_name}`:l.line?.short_name?` ${l.line.short_name}`:l.route_short_name?` ${l.route_short_name}`:''}</Text>
            <Text style={s.muted}>{l.from?.name||'Start'} → {l.to?.name||'End'}
              {l.duration_s?` · ${Math.round(l.duration_s/60)} min`:''}</Text>
            {!!l.headsign&&<Text style={s.caption}>Towards: {l.headsign}</Text>}
          </View></View>):<Text style={s.caption}>Detailed route steps not supplied for this alternative.</Text>}
        <AppButton title={`Open ${selectedOption.label} directions in Google Maps ↗`}
          onPress={()=>void openDirections(selectedOption)}/>
        <Text style={s.caption}>Google Maps may choose a different service. Bus/train choice and steps above come from TransCAPI; Google Maps URL opens transit mode generally.</Text>
      </View>}
    </View>;
  }
  const mapItems=[...displayed.slice(0,25),...allDays.flatMap(d=>d.places),...(hotelChoice?[hotelChoice]:[])];
  const mapUnique=[...new Map(mapItems.map(p=>[p.id,p])).values()];
  const mapCentre=focus||city;
  return <SafeAreaView style={s.root}><StatusBar barStyle="dark-content"/>
    <Modal
      transparent
      visible={prefs}
      animationType="slide"
      onRequestClose={()=>setPrefs(false)}
    >
      <View style={{
        flex:1,
        backgroundColor:'rgba(0,0,0,.5)',
        justifyContent:'center',
        padding:16
      }}>
        <ScrollView
          keyboardShouldPersistTaps="handled"
          contentContainerStyle={{
            backgroundColor:P.white,
            padding:18,
            borderRadius:18
          }}
        >
          <Text style={s.kicker}>
            PERSONALISED ITINERARY
          </Text>

          <Text style={s.title}>
            A trip that fits you.
          </Text>

          <Text style={s.cardLabel}>TRIP DAYS</Text>

          <View style={s.buttonRow}>
            <AppButton
              light
              title="−"
              onPress={()=>{
                if(days>1&&!plan[days]?.length){
                  setDays(days-1);
                }
              }}
            />

            <Text style={s.placeName}>{days} days</Text>

            <AppButton
              light
              title="+"
              onPress={()=>setDays(d=>Math.min(7,d+1))}
            />
          </View>

          <Text style={s.cardLabel}>
            START: {start?.name||'Not selected'}
          </Text>

          <Text style={s.cardLabel}>
            ACCOMMODATION BOOKED?
          </Text>

          <View style={s.tabBar}>
            <Chip
              title="Yes"
              active={stayBooked}
              onPress={()=>setStayBooked(true)}
            />

            <Chip
              title="Not yet"
              active={!stayBooked}
              onPress={()=>setStayBooked(false)}
            />
          </View>

          <Text style={s.cardLabel}>BUDGET (£)</Text>

          <TextInput
            style={s.input}
            value={budget}
            onChangeText={setBudget}
            keyboardType="decimal-pad"
          />

          <Text style={s.cardLabel}>INTERESTS</Text>

          <View style={s.tabBar}>
            {[
              'Landmarks','Museums','Nature',
              'Markets','History','Food'
            ].map(v=>
              <Chip
                key={v}
                title={v}
                active={interests.includes(v)}
                onPress={()=>setInterests(x=>
                  x.includes(v)
                    ?x.filter(i=>i!==v)
                    :[...x,v]
                )}
              />
            )}
          </View>

          <Text style={s.cardLabel}>FOOD NEEDS</Text>

          <View style={s.tabBar}>
            {(['All','Vegetarian','Vegan'] as const).map(v=>
              <Chip
                key={v}
                title={v}
                active={diet===v}
                onPress={()=>setDiet(v)}
              />
            )}
          </View>

          <Text style={s.caption}>
            Preferences are planning inputs.
            No automatic bookings.
          </Text>

          <AppButton
            title="Explore attractions →"
            onPress={()=>setPrefs(false)}
          />
        </ScrollView>
      </View>
    </Modal>
    <ScrollView ref={screenScroll} keyboardShouldPersistTaps="handled" contentContainerStyle={s.content}>
      <View style={s.brandRow}><View style={s.brandLogo}><Text style={{fontSize:23,color:P.lime}}>✦</Text></View>
        <View style={{flex:1}}><Text style={s.brand}>MileMosaic<Text style={{color:P.teal}}>.</Text></Text>
          <Text style={s.micro}>EXPLORE · TRAVEL · PLAN</Text></View>
        <Badge value={online===null?'Connecting':online?'● API online':'● API offline'} kind={online?'good':'warn'}/></View>
      <View style={s.hero}><Text style={s.heroSmall}>✦ DISCOVER THE UK</Text>
        <Text style={s.heroTitle}>{stage==='city'?'Where shall we\ngo next?':stage==='start'?'Where does your\njourney begin?':`Explore ${city?.name||'the UK'}`}</Text>
        <Text style={s.heroSub}>Real attractions · nearby stays · cuisine-based food · transport comparisons</Text>
        <Text style={s.heroStep}>{stage==='city'?'01 / DESTINATION':stage==='start'?'02 / START LOCATION':'03 / EXPLORE & PLAN'}</Text></View>
      {stage==='city'&&<View style={s.panel}>
        <PanelTitle small="DESTINATION" title="Choose your city" desc="Search the UK cities in your local OSM/PostgreSQL database."/>
        <TextInput style={s.input} value={query} onChangeText={setQuery} placeholder="London, Leicester, Edinburgh…"
          placeholderTextColor="#889A9D" onSubmitEditing={()=>void findDestination()} returnKeyType="search" autoCorrect={false}/>
        {cities.map(c=><Pressable key={`${c.name}:${c.latitude}`} style={s.result} onPress={()=>chooseCity(c)}>
          <Text style={s.placeName}>📍 {c.name}</Text><Text style={s.muted}>{c.place_type} →</Text></Pressable>)}
        <AppButton title="Find my destination →" disabled={busy} onPress={()=>void findDestination()}/>
      </View>}
      {stage==='start'&&city&&<View style={s.panel}>
        <PanelTitle small="STARTING LOCATION" title="Pick an airport, station or address"
          desc="You can start at Gatwick even if your destination is Leicester. Search anywhere in Great Britain, or tap the map."/>
        <Pressable style={[s.result,startChoice?.name===`${city.name} city centre`&&s.selected]}
          onPress={()=>setStartChoice({name:`${city.name} city centre`,latitude:city.latitude,longitude:city.longitude})}>
          <Text style={s.placeName}>🏙 {city.name} city centre</Text><Text style={s.link}>Select</Text></Pressable>
        <Text style={s.cardLabel}>SEARCH AIRPORTS / RAILWAY / BUS STATIONS UK-WIDE</Text>
        <TextInput style={s.input} value={startInput} onChangeText={(value:string)=>{setStartInput(value);setLocationResults([]);setError('');}}
          placeholder="e.g. Gatwick Airport, Kings Cross, postcode" placeholderTextColor="#87999C"
          onSubmitEditing={()=>void searchStartingLocation()} returnKeyType="search"/>
        <AppButton title={locationBusy?'Searching…':'Search locations →'} disabled={locationBusy}
          onPress={()=>void searchStartingLocation()}/>
        {locationResults.map((loc,i)=><Pressable key={`${loc.name}:${i}`} style={[s.result,startChoice?.name===loc.name&&s.selected]}
          onPress={()=>{setStartChoice(loc);Keyboard.dismiss();}}>
          <Text style={s.placeName}>📍 {loc.name}</Text><Text style={s.muted}>{loc.category||'Location'} · Select</Text></Pressable>)}
        {!!stops.length&&<><Text style={s.cardLabel}>NEAR YOUR DESTINATION</Text>
          {stops.slice(0,5).map((loc,i)=><Pressable key={`${loc.name}:${i}`} style={[s.result,startChoice?.name===loc.name&&s.selected]}
            onPress={()=>setStartChoice(loc)}><Text style={s.placeName}>🚉 {loc.name}</Text><Text style={s.link}>Select</Text></Pressable>)}</>}
        <Text style={s.cardLabel}>OR TAP THE GOOGLE MAP</Text>
        <MapView provider={PROVIDER_GOOGLE} style={s.startMap} initialRegion={{latitude:city.latitude,longitude:city.longitude,
          latitudeDelta:.12,longitudeDelta:.12}} onPress={(e:{nativeEvent:{coordinate:Coord}})=>{
            const point=e.nativeEvent.coordinate;setPin(point);setStartChoice({...point,name:'Selected map pin'});}}>
          <Marker coordinate={pin||city} pinColor={P.teal} title={startChoice?.name||'Starting point'}/></MapView>
        {!!startChoice&&<Badge value={`✓ Selected: ${startChoice.name}`} kind="good"/>}
        <View style={s.buttonRow}><AppButton title="← Change city" light onPress={()=>setStage('city')}/>
          <AppButton title="Explore attractions →" disabled={!startChoice} onPress={()=>void explore()}/></View>
        <Text style={s.caption}>Location lookup: OSM Photon public demo (limited usage). Production deployment needs a supported geocoding provider.</Text>
      </View>}
      {stage==='explore'&&city&&<>
        <View style={s.tripStrip}><View style={{flex:1}}><Text style={s.micro}>YOUR TRIP</Text>
          <Text style={s.placeName}>📍 {city.name}</Text><Text style={s.muted}>From: {start?.name||'Not selected'}</Text></View>
          <Pressable onPress={()=>setStage('start')}><Text style={s.link}>Edit start ↗</Text></Pressable></View>
        <View style={s.panel}>
          <View style={s.tabBar}>{(['attractions','food','hotels','itinerary'] as const).map(t=><Chip key={t}
            title={t==='attractions'?'✦ Sights':t==='food'?'🍽 Food':t==='hotels'?'🏨 Hotels':'🗓 Trip'}
            active={tab===t} onPress={()=>{
              if(t==='hotels')void discover('hotels');else if(t==='food')void discover('food');
              else {setTab(t);setFocus(null);setError('');}}}/>)}</View>
          <View style={s.buttonRow}><View style={{flex:1}}><Text style={s.cardLabel}>DAYS</Text><View style={s.counter}>
            <Pressable onPress={()=>{if(days>1&&!plan[days]?.length){setDays(days-1);setActiveDay(d=>Math.min(d,days-1));}}}>
              <Text style={s.plus}>−</Text></Pressable><Text style={s.placeName}>{days}</Text>
            <Pressable onPress={()=>setDays(Math.min(7,days+1))}><Text style={s.plus}>＋</Text></Pressable></View></View>
            <View style={{flex:1}}><Text style={s.cardLabel}>BUDGET £</Text>
              <TextInput style={s.input} value={budget} onChangeText={setBudget} keyboardType="decimal-pad" placeholder="500"/></View></View>
          <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{gap:7,marginTop:10}}>
            {allDays.map(d=><Chip key={d.day} title={`Day ${d.day} · ${d.places.length}`} active={d.day===activeDay}
              onPress={()=>{setActiveDay(d.day);setJourney(null);}}/>)}</ScrollView>
          {tab!=='itinerary'&&mapCentre&&<><MapView key={`${city.name}:${tab}:${focus?.id||'city'}`}
            provider={PROVIDER_GOOGLE} style={s.exploreMap} initialRegion={{latitude:mapCentre.latitude,longitude:mapCentre.longitude,
              latitudeDelta:focus ? .023 : .07,longitudeDelta:focus ? .023 : .07}}>
            {!!start&&<Marker coordinate={start} pinColor={P.teal} title={`Start: ${start.name}`}/>}
            {mapUnique.slice(0,35).filter(coordOK).map(p=><Marker key={p.id} coordinate={p} title={p.name}
              pinColor={p.kind==='hotel'?P.purple:p.kind==='restaurant'?'#ED8559':P.teal}/>)}
            {linePaths.map((path,i)=><Polyline key={i} coordinates={path} strokeColor={P.teal} strokeWidth={5}/>)}
          </MapView><Text style={s.caption}>Map markers are from returned coordinates. Routes are only drawn if the provider supplies geometry.</Text></>}
        </View>
        {tab==='attractions'&&<View style={s.panel}>
          <PanelTitle small="REAL TOURIST LANDMARKS" title="What should we visit?"
            desc="Attractions within 3 km of your nearby starting point, or city centre for distant airports. Results spread across the area."/>
          <View style={s.buttonRow}><TextInput style={[s.input,{flex:1}]} value={landmarkInput}
            onChangeText={(text:string)=>{setLandmarkInput(text);setLandmarkResults(null);setSearchedLandmark('');}}
            placeholder="Find Big Ben, London Eye…" placeholderTextColor="#889A9D"
            onSubmitEditing={()=>void searchLandmark()}/>
            <AppButton title="Find" onPress={()=>void searchLandmark()}/></View>
          {!!photoStatus&&
            <Text style={s.caption}>{photoStatus}</Text>
          }

          {!!onlinePhotoStatus&&
            <Text style={s.caption}>
              {onlinePhotoStatus}
            </Text>
          }

          <AppButton
            light
            title="↻ Retry missing attraction photos"
            onPress={()=>{
              requestedPhotos.current.clear();
              setPhotoRetry(n=>n+1);
            }}
          />
          {landmarkResults!==null&&<View style={{marginTop:12,marginBottom:8}}>
            <Text style={s.placeName}>Search results for “{searchedLandmark}” · {landmarkResults.length} found within 3 km</Text>
            <AppButton light title="← Clear search · Show nearby attractions" onPress={()=>{
              setLandmarkResults(null);setSearchedLandmark('');setLandmarkInput('');setError('');
            }}/>
          </View>}
          {busy&&<ActivityIndicator color={P.teal} style={{margin:14}}/>}
          {displayed.map(placeCard)}
          {landmarkResults===null&&rankedAttractions.length>12&&!showMore&&<AppButton light title="Show more attractions ↓" onPress={()=>setShowMore(true)}/>}
        </View>}
        {tab==='food'&&<View style={s.panel}>
          <PanelTitle small="CUISINE-BASED DISCOVERY" title="What would you like to eat?"
            desc={focus?`Food near ${focus.name}`:'Food near the city centre. OSM tags control the cuisine filters.'}/>
          {!!focus&&<AppButton light title="Clear attraction filter" onPress={()=>void discover('food')}/>}
          <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{gap:7,marginBottom:11}}>
            {cuisines.map(c=><Chip key={c} title={c} active={cuisine===c} onPress={()=>setCuisine(c)}/>)}</ScrollView>
          <View style={s.tabBar}>{(['All','Vegetarian','Vegan'] as const).map(d=><Chip key={d} title={d}
            active={diet===d} onPress={()=>setDiet(d)}/>)}</View>
          {!!businessPhotoStatus&&<Text style={s.caption}>{businessPhotoStatus}</Text>}
          <AppButton title="↻ Find more matching venue photos" light onPress={()=>checkMoreBusinessPhotos('food')}/>
          {busy&&<ActivityIndicator color={P.teal} style={{margin:14}}/>}
          {!busy&&!visibleFood.length&&<Text style={s.muted}>No restaurants with these OSM tags in this area. Try All food or a different location.</Text>}
          {visibleFood.map(placeCard)}
        </View>}
        {tab==='hotels'&&<View style={s.panel}>
          <PanelTitle small="YOUR ACCOMMODATION" title="Hotels & live quotes"
            desc={focus?`Nearby stays: ${focus.name}`:'Select a hotel to see its pricing inside the same card.'}/>
          {!!focus&&<AppButton light title="Show hotels around city" onPress={()=>void discover('hotels')}/>}
          {!!businessPhotoStatus&&<Text style={s.caption}>{businessPhotoStatus}</Text>}
          <AppButton title="↻ Find more verified hotel photos" light onPress={()=>checkMoreBusinessPhotos('hotels')}/>
          {busy&&<ActivityIndicator color={P.teal} style={{margin:14}}/>}
          {hotels.map(placeCard)}
        </View>}
        {tab==='itinerary'&&<View style={s.vPage}>
          <View style={s.vIntro}>
            <View style={{flexDirection:'row',justifyContent:'space-between',alignItems:'center',gap:8}}>
              <Text style={s.kicker}>YOUR PERSONALISED ITINERARY</Text>
              <Pressable onPress={()=>setPrefs(true)}>
                <Text style={s.link}>⚙ Preferences</Text>
              </Pressable>
            </View>
            <Text style={s.vPageHeading}>Your day, your way.</Text>
            <Text style={s.vSubheading}>
              Pick the attractions and transport that suit you.
              Add a hotel or a meal stop anywhere in the day.
            </Text>
          </View>

          <View style={s.vStartBar}>
            <Text style={s.vCardName}>🚩 {start?.name||'Starting location not chosen'}</Text>
            <Pressable onPress={()=>setTab('attractions')}>
              <Text style={s.link}>Edit stops ↗</Text>
            </Pressable>
          </View>

          {allDays.map(d=><View key={d.day} style={s.vDay}>
            <View style={s.vDayHeader}>
              <View style={{flex:1}}>
                <Text style={s.vDayName}>
                  Day {d.day} · Explore {d.places.length} places
                </Text>
                <Text style={s.vDaySub}>Your selected attraction order</Text>
              </View>
              <View style={s.vDayPill}>
                <Text style={s.vDayPillText}>
                  {d.places.some(p=>/^\d+(\.\d{1,2})?$/.test(manualCosts[`${d.day}:${p.id}`]||''))
                    ?'User-entered costs':'Prices pending'}
                </Text>
              </View>
            </View>

            <View style={s.vServiceSearch}>
              <Text style={s.vServiceSearchTitle}>🕒 Find bus, Tube and train services</Text>
              <Text style={s.vModeCaption}>
                Search TransCAPI journeys from your chosen time. Each next stop
                is searched after the selected journey arrives, plus visit time and buffer.
              </Text>
              <View style={s.vServiceSearchRow}>
                <View style={{flex:1}}>
                  <Text style={s.vServiceInputLabel}>TRAVEL DATE</Text>
                  <TextInput style={s.input} value={dayDates[d.day]??recommendedTripDate(d.day)}
                    onChangeText={date=>setDayDates(prev=>({...prev,[d.day]:date}))}
                    placeholder="YYYY-MM-DD" autoCorrect={false}/>
                </View>
                <View style={{width:102}}>
                  <Text style={s.vServiceInputLabel}>DEPART AFTER</Text>
                  <TextInput style={s.input} value={dayStarts[d.day]??'09:30'}
                    onChangeText={time=>setDayStarts(prev=>({...prev,[d.day]:time}))}
                    placeholder="09:30" autoCorrect={false}/>
                </View>
              </View>
              <AppButton title="↻ Search services for this day" light
                onPress={()=>searchDayServices(d.day)}/>
            </View>

            <View style={s.vTip}>
              <Text style={s.vTipText}>
                ✦ Route tip: We show options between every stop. Tap an available
                option to select it. Hotel and food stops stay exactly where you put them.
              </Text>
            </View>

            {!d.places.length&&
              <View style={s.vEmpty}>
                <Text style={s.vCardName}>No attractions added yet</Text>
                <AppButton title="＋ Add attractions" light onPress={()=>setTab('attractions')}/>
              </View>
            }

            {dayStops(d.day).map((p,i)=>{
              const leg=itineraryLegs(d.day)[i];
              const route=leg?legCache[leg.key]:undefined;
              const ordered=d.places.findIndex(x=>x.id===p.id);
              const userCost=manualCosts[`${d.day}:${p.id}`]||'';
              const hasCost=/^\d+(\.\d{1,2})?$/.test(userCost);
              const quote=p.kind==='hotel'
                ?hotelQuote?`${money(hotelQuote.rate)}`:'Price unavailable'
                :hasCost?money(Number(userCost)):'Price unavailable';
              const routeTypes:{key:ServiceGroup;title:string;icon:string}[]=[
                {key:'walk',title:'Walk',icon:'🚶'},
                {key:'tube',title:'Tube / Metro',icon:'🚇'},
                {key:'bus',title:'Bus / Coach',icon:'🚌'},
                {key:'train',title:'Train',icon:'🚆'},
                {key:'tram',title:'Tram',icon:'🚊'},
                {key:'ferry',title:'Ferry',icon:'⛴️'},
                {key:'mixed',title:'Mixed transport',icon:'🚉'},
                {key:'other',title:'Other public transport',icon:'🚉'},
                {key:'bicycle',title:'Cycle',icon:'🚲'},
              ];
              const shown=routeTypes
                .filter(t=>['walk','tube','bus'].includes(t.key)||
                  route?.options.some(o=>serviceGroup(o)===t.key))
                .map(t=>({...t,choices:route?.options.filter(o=>serviceGroup(o)===t.key)||[]}));
              const selectedTaxi=!!(leg&&taxiChoices[leg.key]);

              return <View key={`${d.day}:${p.id}:${i}`}>
                {!!leg&&<View style={s.vRouteCard}>
                  <Text style={s.vRouteTitle}>
                    📍 {leg.from.name}  →  {leg.to.name}
                  </Text>
                  <Text style={s.vRouteCaption}>
                    Choose how you want to travel
                  </Text>
                  {!route&&<View style={{flexDirection:'row',alignItems:'center',gap:8,marginVertical:8}}>
                    {!(i>0&&legCache[itineraryLegs(d.day)[i-1].key]&&
                       !legCache[itineraryLegs(d.day)[i-1].key].options.length)&&
                      <ActivityIndicator size="small" color={P.teal}/>}
                    <Text style={s.vLoading}>
                      {i>0&&legCache[itineraryLegs(d.day)[i-1].key]&&
                        !legCache[itineraryLegs(d.day)[i-1].key].options.length
                        ?'Previous journey has no available route or failed. Fix it, then search services again.'
                        :'Finding journeys after previous visit…'}
                    </Text>
                  </View>}
                  {!!route?.routeError&&<Text style={s.vRouteNote}>
                    Provider unavailable: {route.routeError}
                  </Text>}
                  {!!route?.searchedAt&&<Text style={s.vModeCaption}>
                    Searched from {serviceClock(route.searchedAt)} · {new Date(route.searchedAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric',timeZone:'Europe/London'})}
                  </Text>}
                  {!!route?.nextAvailable&&<Text style={s.vRouteNote}>
                    No journeys in the requested departure window; next available options shown.
                  </Text>}
                  {shown.map(t=>{
                    const o=t.choices[0];
                    const hasTransit=t.key!=='walk'&&t.key!=='bicycle';
                    const selected=!selectedTaxi&&t.choices.some(x=>route?.selected===x.id);
                    const metres=o?.legs.reduce((sum,l)=>sum+(l.distance_m||0),0)||0;
                    const expKey=`${leg.key}:${t.key}`;
                    const expanded=!!expandedServiceModes[expKey];
                    return <View key={t.key}>
                      <Pressable
                        disabled={!o}
                        onPress={()=>{
                          if(!o||!route)return;
                          if(hasTransit){
                            setExpandedServiceModes(old=>({...old,[expKey]:!old[expKey]}));
                          }else selectDayService(leg.key,o.id);
                        }}
                        style={[s.vModeRow,selected&&s.vModeSelected,!o&&s.vModeDisabled]}>
                        <View style={s.vModeIcon}><Text style={{fontSize:20}}>{t.icon}</Text></View>
                        <View style={{flex:1,minWidth:0}}>
                          <Text style={s.vModeName}>{t.title}{selected?' · SELECTED':''}</Text>
                          <Text style={s.vModeCaption}>
                            {o
                              ?`${metres>0?(metres/1000).toFixed(1)+' km · ':''}${o.transfers} changes`
                              :route?'No services returned for this mode':'Checking route…'}
                          </Text>
                          {!!o&&hasTransit&&<Text style={s.vModeCaption}>
                            {t.choices.length} journey option{t.choices.length===1?'':'s'} · {serviceClock(departureOf(o).iso)} departure
                          </Text>}
                        </View>
                        <View style={{alignItems:'flex-end',gap:5}}>
                          <Text style={s.vModePrice}>
                            {!o?'—':o.kind==='walk'?'Free':
                              o.complete&&o.fare!==null?money(o.fare):'Fare unknown'}
                          </Text>
                          <Text style={s.vModeCheck}>{hasTransit&&o?(expanded?'⌃':'⌄'):(selected?'●':'○')}</Text>
                        </View>
                      </Pressable>
                      {hasTransit&&expanded&&t.choices.length>0&&
                        <View style={s.vServiceDropdown}>
                          <Text style={s.vServiceDropdownTitle}>Available {t.title.toLowerCase()} journeys · TransCAPI</Text>
                          {t.choices.map((choice,index)=>{
                            const chosen=!selectedTaxi&&route?.selected===choice.id;
                            const board=departureOf(choice),arrive=arrivalOf(choice);
                            const transitLegs=choice.legs.filter(l=>
                              l.transit||!['WALK','BICYCLE'].includes(legMode(l)));
                            return <Pressable key={choice.id}
                              onPress={()=>selectDayService(leg.key,choice.id)}
                              style={[s.vServiceOption,chosen&&s.vServiceOptionSelected]}>
                              <View style={{flexDirection:'row',justifyContent:'space-between',gap:8}}>
                                <Text style={s.vServiceOptionTitle}>
                                  {chosen?'● ':'○ '}Option {index+1} · {choice.minutes} min
                                </Text>
                                <Text style={s.vServiceOptionTitle}>
                                  {choice.complete&&choice.fare!==null?money(choice.fare):'Fare unknown'}
                                </Text>
                              </View>
                              <Text style={s.vServiceTime}>
                                Depart {serviceClock(board.iso)} → Arrive {serviceClock(arrive.iso)}
                                {board.live?' · live estimate':' · timetable when available'}
                              </Text>
                              <Text style={s.vModeCaption}>{choice.transfers} change(s) · Select this journey</Text>
                              {transitLegs.map((service,k)=>{
                                const startTime=serviceTimeValue(service.start_time);
                                const endTime=serviceTimeValue(service.end_time);
                                const line=serviceLine(service);
                                return <View key={`${choice.id}:service:${k}`} style={s.vServiceLeg}>
                                  <Text style={s.vServiceLegName}>
                                    {serviceModeName(service)}{line?` ${line}`:''}
                                    {service.headsign?` → ${service.headsign}`:''}
                                  </Text>
                                  <Text style={s.vServiceLegText}>
                                    Board: {service.from?.name||'Stop not supplied'} · {serviceClock(startTime.iso)}
                                    {startTime.live?' (live estimate)':' (scheduled)'}
                                  </Text>
                                  <Text style={s.vServiceLegText}>
                                    Get off: {service.to?.name||'Stop not supplied'} · {serviceClock(endTime.iso)}
                                  </Text>
                                  {!!service.route?.operator&&<Text style={s.vServiceLegText}>
                                    Operator: {service.route.operator}
                                  </Text>}
                                  {!!service.platform&&<Text style={s.vServiceLegText}>Platform: {service.platform}</Text>}
                                  {!!service.status&&<Text style={s.vServiceLegText}>Status: {service.status.replace(/_/g,' ')}</Text>}
                                </View>;
                              })}
                            </Pressable>;
                          })}
                          <Text style={s.vServiceSmallNote}>
                            These are journey options returned for the selected date/time, not every
                            departure that runs all day. Live times only appear when provided.
                          </Text>
                        </View>}
                    </View>;
                  })}
                  <Pressable style={[s.vModeRow,selectedTaxi&&s.vModeSelected]}
                    onPress={()=>{
                      if(!leg)return;
                      setTaxiChoices(old=>({...old,[leg.key]:true}));
                      clearFollowingServiceRoutes(leg.key);
                      setActiveLegKey('');
                    }}>
                    <View style={s.vModeIcon}><Text style={{fontSize:20}}>🚕</Text></View>
                    <View style={{flex:1}}>
                      <Text style={s.vModeName}>Taxi{selectedTaxi?' · SELECTED':''}</Text>
                      <Text style={s.vModeCaption}>Driving directions; taxi fare not provided</Text>
                    </View>
                    <Text style={s.vModePrice}>Fare unknown</Text>
                    <Text style={s.vModeCheck}>{selectedTaxi?'●':'○'}</Text>
                  </Pressable>
                  <Pressable onPress={()=>{
                    if(!leg)return;
                    const o=route?.options.find(x=>x.id===route.selected);
                    const mode=selectedTaxi?'driving':o?GoogleMode(o):'walking';
                    const url=`https://www.google.com/maps/dir/?${params({
                      api:1,origin:`${leg.from.latitude},${leg.from.longitude}`,
                      destination:`${leg.to.latitude},${leg.to.longitude}`,travelmode:mode
                    })}`;
                    void Linking.openURL(url).catch(()=>
                      Alert.alert('Directions unavailable','Unable to open Google Maps'));
                  }}>
                    <Text style={s.vDirections}>View directions for selected mode ↗</Text>
                  </Pressable>
                </View>}

                {p.kind==='hotel'?<View style={s.vHotelBanner}>
                  <View style={s.vHotelEmoji}><Text style={{fontSize:25}}>🏨</Text></View>
                  <View style={{flex:1}}>
                    <Text style={s.vCardName}>Hotel stop · {p.name}</Text>
                    <Text style={s.vHotelDetail}>
                      {hotelQuote?`${money(hotelQuote.rate)} for tonight / room`:'Tonight’s rate unavailable'}
                    </Text>
                    <Text style={s.vHotelDetail}>Check-in not confirmed · No booking made</Text>
                  </View>
                  <View style={s.vStayBadge}><Text style={s.vStayText}>STAY</Text></View>
                </View>:p.kind==='restaurant'?<View style={s.vHotelBanner}>
                  <View style={s.vHotelEmoji}><Text style={{fontSize:25}}>🍽️</Text></View>
                  <View style={{flex:1}}>
                    <Text style={s.vCardName}>Food stop · {p.name}</Text>
                    <Text style={s.vHotelDetail}>Menu price unavailable</Text>
                  </View>
                </View>:<View style={s.vAttractionCard}>
                  <View style={s.vAttractionHeader}>
                    <View style={s.vCount}><Text style={s.vCountText}>{ordered+1}</Text></View>
                    <TripThumb place={p}/>
                    <View style={{flex:1,minWidth:0}}>
                      <Text style={s.vCardName} numberOfLines={2}>{p.name}</Text>
                      <Text style={s.vKind} numberOfLines={2}>
                        {p.category.replace(/_/g,' ')}
                      </Text>
                    </View>
                    <View style={s.vPriceBadge}>
                      <Text style={s.vPriceText}>{hasCost?quote:'Price unavailable'}</Text>
                      {hasCost&&<Text style={s.vPriceSub}>your estimate</Text>}
                    </View>
                  </View>
                  <View style={s.vLocationLine}>
                    <Text style={s.vLocationText}>📍 {p.name}</Text>
                    <Text style={s.vLocationText}>
                      {p.openingHours?'OSM opening hours':'Hours not verified'}
                    </Text>
                  </View>
                  <View style={s.vActionRow}>
                    <Pressable style={s.vSoftButton} onPress={()=>{
                      setHotelWaypoint(d.day,p.id);
                      void discover('hotels',p);
                    }}>
                      <Text style={s.vSoftLabel}>
                        {hotelAfter?.day===d.day&&hotelAfter.id===p.id
                          ?'✓ Change hotel':'🏨 Nearby hotels'}
                      </Text>
                    </Pressable>
                    <Pressable style={s.vSoftButton} onPress={()=>{
                      setFoodAfter({day:d.day,id:p.id});
                      void discover('food',p);
                    }}>
                      <Text style={s.vSoftLabel}>
                        {foodAfter?.day===d.day&&foodAfter.id===p.id&&foodChoice
                          ?'✓ Change restaurant':'🍽️ Choose restaurant'}
                      </Text>
                    </Pressable>
                  </View>
                  <View style={s.vManageRow}>
                    <Pressable disabled={ordered<=0}
                      onPress={()=>moveStop(d.day,ordered,-1)}>
                      <Text style={[s.vManageText,ordered<=0&&{opacity:.35}]}>↑ Earlier</Text>
                    </Pressable>
                    <Pressable disabled={ordered>=d.places.length-1}
                      onPress={()=>moveStop(d.day,ordered,1)}>
                      <Text style={[s.vManageText,ordered>=d.places.length-1&&{opacity:.35}]}>↓ Later</Text>
                    </Pressable>
                    <Pressable onPress={()=>{
                      setPlan(old=>({...old,
                        [d.day]:(old[d.day]||[]).filter(x=>x.id!==p.id)}));
                      setLegCache({});
                    }}>
                      <Text style={[s.vManageText,{color:P.red}]}>Remove</Text>
                    </Pressable>
                    <Pressable onPress={()=>setEditCosts(old=>({...old,[p.id]:!old[p.id]}))}>
                      <Text style={s.vManageText}>£ Estimate</Text>
                    </Pressable>
                  </View>
                  {!!editCosts[p.id]&&<View style={{marginTop:9}}>
                    <Text style={s.vRouteCaption}>Optional user-entered ticket estimate (£)</Text>
                    <TextInput style={s.input} keyboardType="decimal-pad"
                      placeholder="Leave blank when unknown"
                      placeholderTextColor="#80908B"
                      value={userCost}
                      onChangeText={(v:string)=>setManualCosts(old=>({...old,[`${d.day}:${p.id}`]:v}))}/>
                  </View>}
                </View>}
              </View>;
            })}
            {dayStops(d.day).length>0&&<>
              <Pressable style={s.vMapToggle}
                onPress={()=>setMapDay(old=>old===d.day?null:d.day)}>
                <Text style={s.vDirections}>
                  🗺 {mapDay===d.day?'Hide route map':'View route map'}
                </Text>
              </Pressable>
              {mapDay===d.day&&<MapView
                provider={PROVIDER_GOOGLE}
                style={s.routeMap}
                initialRegion={dayMapRegion(d.day)}>
                {itineraryLegs(d.day)[0]&&<Marker
                  coordinate={itineraryLegs(d.day)[0].from} title="Start"/>}
                {dayStops(d.day).map((stop,j)=><Marker
                  key={`${stop.id}:${j}`} coordinate={stop} title={stop.name}
                  pinColor={stop.kind==='hotel'?P.purple:P.teal}/>)}
                {itineraryLegs(d.day).flatMap(l=>
                  taxiChoices[l.key]?[]:renderRouteCoords(
                    legCache[l.key]?.options.find(o=>
                      o.id===legCache[l.key]?.selected)||null))
                  .map((coords,j)=><Polyline key={j} coordinates={coords}
                    strokeWidth={4} strokeColor={P.teal}/>)}
              </MapView>}
            </>}
          </View>)}

          {!!hotelChoice&&!hotelAfter&&<View style={s.vTip}>
            <Text style={s.vTipText}>
              🏨 {hotelChoice.name} selected. Tap “Nearby hotels” below an
              attraction to position the hotel in your route.
            </Text>
          </View>}

          <View style={s.vBudget}>
            <Text style={s.vBudgetLabel}>ESTIMATED TOTAL SO FAR</Text>
            <Text style={s.vBudgetNumber}>{money(knownTotal)}</Text>
            <View style={s.vBreakdown}>
              <Text style={s.vBreakItem}>🎟️ Entered costs: {money(knownManualCost)}</Text>
              <Text style={s.vBreakItem}>🚆 Known fares: {money(knownTransport)}</Text>
              <Text style={s.vBreakItem}>🏨 Hotel: {hotelQuote?money(hotelQuote.rate):'Not quoted'}</Text>
            </View>
            <Text style={s.vBudgetFoot}>
              This is a partial total, not a complete trip price. Unknown fares,
              taxis, tickets and restaurant prices are excluded.
            </Text>
          </View>
          <View style={s.buttonRow}>
            <AppButton light title="＋ More attractions" onPress={()=>setTab('attractions')}/>
            <AppButton title="🏨 Find hotels" onPress={()=>void discover('hotels')}/>
          </View>
          {activeLegKey.startsWith('card:')&&routePanel()}
        </View>}
      </>}
      {!!error&&<View style={s.errorBox}><Text style={s.errorText}>{error}</Text></View>}
      <Text style={s.footer}>MileMosaic · OSM / Wikipedia / Xotelo / TransCAPI · Check provider terms & attribution</Text>
    </ScrollView>

    {stage==='explore' &&
      tab!=='itinerary' &&
      Object.values(plan).some(items=>items.length>0) && (
      <View style={{
        backgroundColor:P.white,
        paddingHorizontal:16,
        paddingTop:10,
        paddingBottom:14,
        borderTopWidth:1,
        borderTopColor:P.line
      }}>
        <Pressable
          accessibilityRole="button"
          onPress={()=>{
            Keyboard.dismiss();
            setJourney(null);
            setActiveLegKey('');
            setTab('itinerary');
            screenScroll.current?.scrollTo({
              y:300,
              animated:true
            });
          }}
          style={{
            backgroundColor:P.navy,
            minHeight:52,
            borderRadius:13,
            alignItems:'center',
            justifyContent:'center'
          }}
        >
          <Text style={{
            color:P.white,
            fontSize:14,
            fontWeight:'900'
          }}>
            Continue to itinerary → (
            {Object.values(plan).reduce(
              (n,items)=>n+items.length,0
            )} added)
          </Text>
        </Pressable>
      </View>
    )}

  </SafeAreaView>;
}

