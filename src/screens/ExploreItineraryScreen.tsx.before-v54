  // MILEMOSAIC_ROUTE_TIMELINE_V41
  const [journey,setJourney]=useState<Journey|null>(null);
  const [hotelAfter,setHotelAfter]=useState<{day:number;id:string}|null>(null);
  const [legCache,setLegCache]=useState<Record<string,Journey>>({});
  const [expandedServiceModes,setExpandedServiceModes]=useState<Record<string,boolean>>({});
  const [appliedServiceSearch,setAppliedServiceSearch]=useState<Record<number,{date:string;time:string}>>({});
  const [serviceSearchRevision,setServiceSearchRevision]=useState(0);
  const serviceSearchVersion=useRef<Record<number,number>>({});
  const [routingDay,setRoutingDay]=useState<number|null>(null);
  const [dayDates,setDayDates]=useState<Record<number,string>>({});
  const [dayStarts,setDayStarts]=useState<Record<number,string>>({});
  const [visitLengths,setVisitLengths]=useState<Record<string,string>>({});
  const [journeyBusy,setJourneyBusy]=useState(false);
