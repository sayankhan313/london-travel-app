import React, { useEffect, useMemo, useRef, useState } from 'react';
import {
  ActivityIndicator, Alert, Image, Keyboard, Linking, Modal, Platform,
  Pressable, SafeAreaView, ScrollView, StatusBar, StyleSheet,
  Text, TextInput, View,
} from 'react-native';
import MapView, { Marker, Polyline, PROVIDER_GOOGLE } from 'react-native-maps';

// Local Android emulator: adb reverse tcp:3001 tcp:3001
const API_HOSTS = Platform.OS === 'android'
  ? ['http://localhost:3001', 'http://10.0.2.2:3001']
  : ['http://localhost:3001'];
let selectedHost = API_HOSTS[0];
const P = { navy:'#17323A', teal:'#087F78', lime:'#DCF57E', bg:'#F6F8F5', white:'#FFFFFF',
  muted:'#637A83', line:'#E3E9E5', mint:'#E9F5F0', peach:'#FFF0E4', blue:'#E9F0FF',
  purple:'#6A58CA', warn:'#A05C12', red:'#B42318', green:'#17755D' };

type Coord = {latitude:number; longitude:number};
type City = Coord & {name:string; place_type:string};
type Location = Coord & {name:string; category?:string};
type Kind = 'attraction' | 'restaurant' | 'hotel';
type Place = Coord & {id:string; name:string; kind:Kind; category:string; distance?:number;
  image?:string; imagePage?:string; cuisine?:string; vegetarian?:string; vegan?:string;
  rating?:number; hotelKey?:string; match?:string; openingHours?:string;
  commonsFile?:string; wikipediaTitle?:string; imageCredit?:string; imageLicense?:string; imageLicenseUrl?:string; imageNote?:string};
type Rate = {name:string; rate:number};
type Leg = {mode?:string; transit?:boolean; duration_s?:number; distance_m?:number;
  from?:{name?:string;latitude?:number;longitude?:number};
  to?:{name?:string;latitude?:number;longitude?:number};
  route?:{line?:string;short_name?:string;long_name?:string;operator?:string;operator_id?:string};
  line?:{short_name?:string;name?:string};
  route_short_name?:string; headsign?:string; leg_geometry?:string; leg_geometry_source?:string;
  trip_id?:string; platform?:string; status?:string; real_time?:boolean;
  start_time?:ServiceTimeValue; end_time?:ServiceTimeValue;
  delay_reason?:string; cancel_reason?:string;};
type ServiceTimeValue=string|{scheduled?:string|null;estimated?:string|null;delay_s?:number|null}|null;
type Itinerary = {duration_s?:number;start_time?:string;end_time?:string;
  fare?:{amount_gbp?:number;complete?:boolean}|null; legs?:Leg[]};
type Option = {id:string;label:string;icon:string;minutes:number;fare:number|null;
  complete:boolean;transfers:number;legs:Leg[];kind:'transit'|'walk'|'bicycle'; start?:string;end?:string};
type Journey = {from:Location;to:Location;options:Option[];best:string;selected:string;
  routeError?:string;searchedAt?:string;nextAvailable?:boolean};

const params = (p:Record<string,string|number>) => Object.entries(p)
  .map(([k,v])=>`${encodeURIComponent(k)}=${encodeURIComponent(String(v))}`).join('&');
const money=(v:number)=>`£${v.toFixed(2)}`;
const errString=(e:unknown)=>e instanceof Error?e.message:String(e);
const coordOK=(v:unknown):v is Coord=>Boolean(v&&typeof v==='object'&&
  Number.isFinite(Number((v as Coord).latitude))&&Number.isFinite(Number((v as Coord).longitude)));
const num=(v:unknown)=>Number.isFinite(Number(v))?Number(v):NaN;
const validDate=(s:string)=>/^\d{4}-\d{2}-\d{2}$/.test(s)&&
  Number.isFinite(Date.parse(`${s}T00:00:00Z`))&&
  new Date(`${s}T00:00:00Z`).toISOString().slice(0,10)===s;

// MILEMOSAIC_WIKI_NATIVE_HEADERS_V48
// Wikimedia requires identifiable clients; replace with your project URL before release.
const WIKIMEDIA_USER_AGENT =
  'MileMosaic/0.1 (https://github.com/sayankhan313) ReactNative/Android';

function photoSource(uri:string){
  const isWiki=uri.startsWith('https://thumb.wikimedia.org/')||
    uri.startsWith('https://upload.wikimedia.org/');
  return isWiki
    ? {uri,headers:{'User-Agent':WIKIMEDIA_USER_AGENT}}
    : {uri};
}

// MM_COMPACT_UI_44
function tonight(){
  const d = new Date();
  const next = new Date(d);
  next.setDate(next.getDate() + 1);

  const date = (v:Date) => [
    v.getFullYear(),
    String(v.getMonth()+1).padStart(2,'0'),
    String(v.getDate()).padStart(2,'0')
  ].join('-');

  return {start:date(d), end:date(next)};
}
// MILEMOSAIC_VISUAL_V45
function TripThumb({place}:{place:Place}){
  const [broken,setBroken]=useState(false);
  useEffect(()=>setBroken(false),[place.image]);
  if(place.image&&!broken)return <Image source={photoSource(place.image)}
    onError={()=>setBroken(true)} style={s.vThumb}/>;
  return <View style={s.vThumbFallback}>
    <Text style={{fontSize:26}}>{place.kind==='hotel'?'🏨':
      place.kind==='restaurant'?'🍽️':'🏛️'}</Text>
  </View>;
}
function haversine(a:Coord,b:Coord){
  const R=6371000,rad=Math.PI/180,dLat=(b.latitude-a.latitude)*rad,dLon=(b.longitude-a.longitude)*rad;
  const h=Math.sin(dLat/2)**2+Math.cos(a.latitude*rad)*Math.cos(b.latitude*rad)*Math.sin(dLon/2)**2;
  return 2*R*Math.asin(Math.min(1,Math.sqrt(h)));
}
function normal(s:string){return s.toLowerCase().replace(/[^a-z0-9 ]/g,' ').replace(/\b(the|hotel|london|edinburgh|museum|of|at|a)\b/g,' ').replace(/\s+/g,' ').trim();}
// MILEMOSAIC_BUSINESS_IMAGES_V51: AbortSignal type fix + accurate lookup status
// MILEMOSAIC_BUSINESS_IMAGES_V49
// OSM can identify a Wikimedia file or Wikipedia article; external image links
// are not automatically treated as reusable or correctly licensed.
function commonsFileFromOSM(raw:any):string|undefined{
  const tags=raw.tags||raw.osm_tags||{};
  const candidate=[raw.wikimedia_commons,tags.wikimedia_commons,
    raw.image,tags.image].find(v=>typeof v==='string' &&
      (/^(File|Image):/i.test(v.trim()) ||
       /^https:\/\/commons\.wikimedia\.org\/wiki\/(File|Image):/i.test(v.trim())));
  if(!candidate)return undefined;
  let v=String(candidate).trim();
  v=v.replace(/^https:\/\/commons\.wikimedia\.org\/wiki\//i,'');
  try{v=decodeURIComponent(v);}catch{}
  return /^Image:/i.test(v)?v.replace(/^Image:/i,'File:'):
    /^File:/i.test(v)?v:undefined;
}
function wikipediaTitleFromOSM(raw:any):string|undefined{
  const v=raw.wikipedia||raw.tags?.wikipedia||raw.osm_tags?.wikipedia;
  if(typeof v!=='string')return undefined;
  const title=v.trim().replace(/^en:/i,'').replace(/_/g,' ');
  // Only English Wikipedia is queried in this implementation.
  return !/^[a-z]{2,3}:/i.test(title)&&title.length>3?title:undefined;
}
function placeFromOSM(raw:any,kind:Kind):Place{
  return {id:`osm:${raw.osm_type}:${raw.osm_id}`,name:String(raw.name),kind,
    latitude:Number(raw.latitude),longitude:Number(raw.longitude),category:String(raw.subcategory||kind),
    distance:num(raw.distance_m),cuisine:raw.cuisine||undefined,
    vegetarian:raw.vegetarian||undefined,vegan:raw.vegan||undefined,
    openingHours:raw.opening_hours||undefined,match:kind==='hotel'?'osm-only':undefined,
    commonsFile:commonsFileFromOSM(raw),wikipediaTitle:wikipediaTitleFromOSM(raw)};
}
function hotelFromX(raw:any):Place{
  return {id:`xotelo:${raw.hotel_key}`,name:String(raw.name),kind:'hotel',category:'Hotel',
    latitude:Number(raw.latitude),longitude:Number(raw.longitude),distance:num(raw.distance_m),
    rating:typeof raw.rating==='number'?raw.rating:undefined,image:raw.image||undefined,
    hotelKey:raw.hotel_key,match:raw.match?.status||'unmatched',
    commonsFile:commonsFileFromOSM(raw),wikipediaTitle:wikipediaTitleFromOSM(raw)};
}
async function api<T>(path:string):Promise<T>{
  let message='Network error';
  for(const host of [selectedHost,...API_HOSTS.filter(h=>h!==selectedHost)]){
    const controller=new AbortController();
    const timer=setTimeout(()=>controller.abort(),path.includes('matched')?48000:22000);
    try{
      const response=await fetch(host+path,{signal:controller.signal as unknown as RequestInit['signal']});
      const data:any=await response.json();
      selectedHost=host;
      if(!response.ok||data.success===false)throw new Error(data.error||`HTTP ${response.status}`);
      return data as T;
    }catch(e){message=errString(e);if(!/network|fetch|abort|timeout/i.test(message))throw e;}
    finally{clearTimeout(timer);}
  }
  throw new Error(`Backend inaccessible (${message}). Start npm run dev and adb reverse tcp:3001 tcp:3001.`);
}
// Wikipedia's published geosearch + thumbnail API, not fake attraction photos.
async function wikipediaNearby(city:City):Promise<Place[]>{
  const url='https://en.wikipedia.org/w/api.php?'+params({
    action:'query',format:'json',origin:'*',generator:'geosearch',
    ggscoord:`${city.latitude}|${city.longitude}`,ggsradius:3000,ggslimit:50,
    prop:'coordinates|pageimages|info',inprop:'url',piprop:'thumbnail',pithumbsize:330,
  });
  const r=await fetch(url,{headers:{'User-Agent':WIKIMEDIA_USER_AGENT}});if(!r.ok)throw new Error('Wikipedia photos unavailable');
  const json:any=await r.json();
  return Object.values(json.query?.pages||{}).flatMap((v:any):Place[]=>{
    const lat=num(v.coordinates?.[0]?.lat),lon=num(v.coordinates?.[0]?.lon);
    if(!v.title||!Number.isFinite(lat)||!Number.isFinite(lon)||
       haversine(city,{latitude:lat,longitude:lon})>3000)return [];
    return [{id:`wiki:${v.pageid}`,name:v.title,kind:'attraction',category:'Wikipedia landmark',
      latitude:lat,longitude:lon,image:v.thumbnail?.source,
      imagePage:v.fullurl||`https://en.wikipedia.org/wiki/${encodeURIComponent(v.title.replace(/ /g,'_'))}`}];
  });
}
async function wikipediaSearch(term:string,city:City):Promise<Place[]>{
  const url='https://en.wikipedia.org/w/api.php?'+params({action:'query',format:'json',origin:'*',
    generator:'search',gsrsearch:term,gsrlimit:12,
    prop:'coordinates|pageimages|info',inprop:'url',piprop:'thumbnail',pithumbsize:330});
  const r=await fetch(url,{headers:{'User-Agent':WIKIMEDIA_USER_AGENT}});if(!r.ok)throw new Error('Landmark search unavailable');
  const data:any=await r.json();
  return Object.values(data.query?.pages||{}).flatMap((v:any):Place[]=>{
    const lat=num(v.coordinates?.[0]?.lat),lon=num(v.coordinates?.[0]?.lon);
    if(!v.title||!Number.isFinite(lat)||!Number.isFinite(lon)||
      haversine(city,{latitude:lat,longitude:lon})>3000)return [];
    return [{id:`wiki:${v.pageid}`,name:v.title,kind:'attraction',category:'Wikipedia landmark',
      latitude:lat,longitude:lon,image:v.thumbnail?.source,
      imagePage:v.fullurl||`https://en.wikipedia.org/wiki/${encodeURIComponent(v.title.replace(/ /g,'_'))}`}];
  });
}
// Exact page lookup is a fallback when full-text search doesn't return the canonical page.
async function wikipediaExactTitle(term:string,city:City):Promise<Place[]>{
  const url='https://en.wikipedia.org/w/api.php?'+params({
    action:'query',format:'json',origin:'*',redirects:1,titles:term,
    prop:'coordinates|pageimages|info',inprop:'url',piprop:'thumbnail',pithumbsize:330,
  });
  const response=await fetch(url,{headers:{'User-Agent':WIKIMEDIA_USER_AGENT}});
  if(!response.ok)throw new Error('Wikipedia title lookup unavailable');
  const json:any=await response.json();
  return Object.values(json.query?.pages||{}).flatMap((page:any):Place[]=>{
    const latitude=num(page.coordinates?.[0]?.lat);
    const longitude=num(page.coordinates?.[0]?.lon);
    if(!page.title||!Number.isFinite(latitude)||!Number.isFinite(longitude)||
       haversine(city,{latitude,longitude})>3000)return [];
    return [{id:`wiki:${page.pageid}`,name:page.title,kind:'attraction',
      category:'Wikipedia landmark',latitude,longitude,image:page.thumbnail?.source,
      imagePage:page.fullurl||`https://en.wikipedia.org/wiki/${encodeURIComponent(page.title.replace(/ /g,'_'))}`}];
  });
}
function combineAttractions(osm:Place[],wiki:Place[]):Place[]{
  const enriched=osm.map(o=>{
    const match=wiki.find(w=>haversine(w,o)<350&&
      (normal(w.name)===normal(o.name)||
       (normal(w.name).length>3&&normal(o.name).includes(normal(w.name)))||
       (normal(o.name).length>3&&normal(w.name).includes(normal(o.name)))||
       (haversine(w,o)<100&&photoNameSimilarity(w.name,o.name)>=.92)));
    return match?{...o,image:match.image,imagePage:match.imagePage}:o;
  });
  const extra=wiki.filter(w=>!enriched.some(o=>haversine(w,o)<250&&
    (normal(o.name).includes(normal(w.name))||normal(w.name).includes(normal(o.name)))));
  return [...enriched,...extra];
}


// MILEMOSAIC_WIKI_ONLINE_V47
// Fetches online image URLs only. No photo files saved.
type WikiOnlineImage={
  image:string;
  imagePage:string;
};

async function wikiOnlineImages(
  places:Place[]
):Promise<Record<string,WikiOnlineImage>>{

  const targets=places.filter(
    p=>p.kind==='attraction'&&!p.image
  ).slice(0,12);

  if(!targets.length)return {};

  const url='https://en.wikipedia.org/w/api.php?'+params({
    action:'query',
    format:'json',
    formatversion:2,
    origin:'*',
    redirects:1,
    prop:'pageimages|coordinates|info',
    inprop:'url',
    piprop:'thumbnail',
    pilicense:'free',
    pithumbsize:330,
    titles:targets.map(p=>
      p.name.replace(/\|/g,' ')
    ).join('|')
  });

  const response=await fetch(url,{
    headers:{Accept:'application/json','User-Agent':WIKIMEDIA_USER_AGENT}
  });

  if(!response.ok){
    throw new Error(
      `Wikipedia image API HTTP ${response.status}`
    );
  }

  const json:any=await response.json();

  if(json.error){
    throw new Error(
      json.error.info||json.error.code
    );
  }

  const pages:Array<any>=
    Array.isArray(json.query?.pages)
      ?json.query.pages:[];

  const output:Record<string,WikiOnlineImage>={};

  const nameKey=(name:string)=>
    normal(name).replace(/\s+/g,' ').trim();

  for(const place of targets){

    const match=pages.find(page=>{
      const img=page.thumbnail?.source;

      if(typeof img!=='string'||
         !img.startsWith('https://')){
        return false;
      }

      const exact=
        nameKey(page.title||'')===
        nameKey(place.name);

      const coordinates=page.coordinates?.[0];

      const nearby=coordinates&&
        Number.isFinite(Number(coordinates.lat))&&
        Number.isFinite(Number(coordinates.lon))&&
        haversine(place,{
          latitude:Number(coordinates.lat),
          longitude:Number(coordinates.lon)
        })<450;

      const a=nameKey(place.name);
      const b=nameKey(page.title||'');

      return exact||(
        nearby&&
        a.length>5&&
        b.length>5&&
        (a.includes(b)||b.includes(a))
      );
    });

    if(match){
      output[place.id]={
        image:match.thumbnail.source,
        imagePage:match.fullurl||
          `https://en.wikipedia.org/wiki/${
            encodeURIComponent(
              String(match.title).replace(/ /g,'_')
            )
          }`
      };
    }
  }

  return output;
}

// MILEMOSAIC_BUSINESS_IMAGES_V52
// One safe name matcher for OSM hotels/restaurants, Wikipedia, and Commons.
// Exact OSM file links > nearby matching article > geotagged Commons > labelled
// brand/article image. Fuzzy name matches alone NEVER verify a branch photo.
type BusinessPhoto={image:string;imagePage:string;imageCredit?:string;
  imageLicense?:string;imageLicenseUrl?:string;imageNote?:string};
const WIKI_JSON_HEADERS={
  Accept:'application/json',
  'User-Agent':WIKIMEDIA_USER_AGENT,
  'Api-User-Agent':WIKIMEDIA_USER_AGENT
};
const WIKI_TIMEOUT_MS=10000;
function wikiDelay(ms:number):Promise<void>{
  return new Promise(resolve=>setTimeout(resolve,ms));
}
async function wikiJson(url:string,context:string):Promise<any>{
  for(let attempt=0;attempt<2;attempt++){
    const controller=new AbortController();
    const timeout=setTimeout(()=>controller.abort(),WIKI_TIMEOUT_MS);
    try{
      const response=await fetch(url,{
        headers:WIKI_JSON_HEADERS,
        signal:controller.signal as unknown as RequestInit['signal']
      });
      if(!response.ok){
        const retryAfter=response.headers?.get?.('Retry-After');
        const numeric=retryAfter?Number(retryAfter):NaN;
        const seconds=Number.isFinite(numeric)?numeric:
          retryAfter&&Number.isFinite(Date.parse(retryAfter))
            ?Math.max(0,(Date.parse(retryAfter)-Date.now())/1000):NaN;
        // Respect a server-provided longer waiting period instead of
        // hammering Wikimedia again. The user can try later.
        if((response.status===429||response.status===503)&&
           Number.isFinite(seconds)&&seconds>5){
          throw new Error(`${context}: HTTP ${response.status}; retry after ${seconds}s`);
        }
        if(attempt===0&&[429,500,502,503,504].includes(response.status)){
          const delay=Number.isFinite(seconds)?Math.max(700,seconds*1000):900;
          await wikiDelay(Math.min(5000,delay));
          continue;
        }
        throw new Error(`${context}: HTTP ${response.status}`);
      }
      const json:any=await response.json();
      if(json.error){
        const info=String(json.error.info||json.error.code||'API error');
        if(attempt===0&&/too busy|ratelimit|maxlag|temporar/i.test(info)){
          await wikiDelay(900);
          continue;
        }
        throw new Error(`${context}: ${info}`);
      }
      return json;
    }catch(e){
      if(attempt===0&&/network request failed|timed?\s*out|abort/i.test(errString(e))){
        await wikiDelay(750);
        continue;
      }
      console.warn('[MileMosaic business images request]',context,errString(e));
      throw e;
    }finally{clearTimeout(timeout);}
  }
  throw new Error(`${context}: unavailable`);
}
function businessNameKey(v:string):string{
  return String(v||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'')
    .replace(/([a-z])['’]s\b/gi,'$1s')
    .toLowerCase().replace(/&/g,' and ')
    .replace(/[^a-z0-9]+/g,' ').replace(/^the /,'')
    .replace(/\s+/g,' ').trim();
}
// Common UK chain aliases are aliases, not evidence that a branch photo is exact.
const PHOTO_BRAND_ALIASES:Record<string,string>={
  'costa':'costa coffee',
  'costa coffee':'costa coffee',
  'pret':'pret a manger',
  'pret a manger':'pret a manger',
  'cafe nero':'caffe nero',
  'caffe nero':'caffe nero',
  'cafe concerto':'caffe concerto',
  'caffe concerto':'caffe concerto'
};
function canonicalPhotoName(v:string):string{
  const name=businessNameKey(v);
  return PHOTO_BRAND_ALIASES[name]||name;
}
function photoEditSimilarity(a:string,b:string):number{
  if(a===b)return 1;
  if(!a||!b)return 0;
  if(Math.abs(a.length-b.length)>Math.max(a.length,b.length)*.25)return 0;
  let previous=Array.from({length:b.length+1},(_,i)=>i);
  for(let i=1;i<=a.length;i++){
    const row=[i];
    for(let j=1;j<=b.length;j++){
      row[j]=Math.min(previous[j]+1,row[j-1]+1,
        previous[j-1]+(a[i-1]===b[j-1]?0:1));
    }
    previous=row;
  }
  return 1-previous[b.length]/Math.max(a.length,b.length);
}
function photoNameSimilarity(a:string,b:string):number{
  const x=canonicalPhotoName(a);
  const y=canonicalPhotoName(b);
  if(!x||!y)return 0;
  if(x===y)return 1;
  const xTokens=x.split(' '),yTokens=y.split(' ');
  // Name agreement is required. One shared generic word isn't enough.
  const shared=xTokens.filter(t=>yTokens.includes(t)).length;
  const overlap=2*shared/(xTokens.length+yTokens.length);
  const edit=photoEditSimilarity(x,y);
  return Math.max(edit,overlap*.55+edit*.45);
}
function wikipediaPhotoTitles(place:Place):string[]{
  const key=businessNameKey(place.name);
  // A one-word title like "Tortilla" may refer to food, not the chain.
  // Likewise "Costa" is ambiguous without its Coffee brand qualifier.
  const titles=key==='tortilla'&&!place.wikipediaTitle
    ?['Tortilla Mexican Grill','Tortilla (restaurant chain)']
    :key==='costa'&&!place.wikipediaTitle
      ?['Costa Coffee']
      :[place.wikipediaTitle,place.name];
  const alias=canonicalPhotoName(place.name);
  if(alias!==key)titles.push(alias);
  if(key==='prezzo')titles.push('Prezzo (restaurant)');
  return [...new Set(titles.filter((v):v is string=>!!v)
    .map(v=>v.replace(/\|/g,' ').trim()).filter(Boolean))];
}
function wikiTitleWithoutQualifier(v:string):string{
  // "Prezzo (restaurant)" -> "Prezzo" for a confident topic match.
  return v.replace(/\s+\((restaurant|restaurant chain|hotel|hotel chain|coffeehouse|coffee shop|cafe|caf\u00e9|company)\)$/i,'');
}
function wikiExtText(v:any):string|undefined{
  if(typeof v!=='string')return undefined;
  const plain=v.replace(/<[^>]*>/g,' ').replace(/&nbsp;/g,' ')
    .replace(/&amp;/g,'&').replace(/&quot;/g,'"')
    .replace(/&#39;/g,"'").replace(/\s+/g,' ').trim();
  return plain?plain.slice(0,180):undefined;
}
function commonsPhotoFromPage(page:any,note='OSM-linked venue photo'):BusinessPhoto|undefined{
  const i=page?.imageinfo?.[0];
  const m=i?.extmetadata;
  const license=wikiExtText(m?.LicenseShortName?.value);
  if(!license||/\bNC\b|\bND\b|non.?commercial|fair.?use/i.test(license))return undefined;
  const image=i?.thumburl||i?.url;
  const mime=String(i?.thumbmime||i?.mime||'');
  if(typeof image!=='string'||!image.startsWith('https://')||
     !/^image\/(jpeg|png|webp)$/.test(mime))return undefined;
  const pageUrl=i?.descriptionurl||
    `https://commons.wikimedia.org/wiki/${encodeURIComponent(String(page.title).replace(/ /g,'_'))}`;
  return {image,imagePage:pageUrl,imageCredit:wikiExtText(m?.Artist?.value),
    imageLicense:license,imageLicenseUrl:m?.LicenseUrl?.value||undefined,
    imageNote:note};
}
async function commonsLinkedBusinessPhotos(places:Place[]):Promise<Record<string,BusinessPhoto>>{
  const named=places.filter(p=>p.commonsFile?.startsWith('File:'));
  if(!named.length)return {};
  const titles=[...new Set(named.map(p=>p.commonsFile!))].slice(0,12);
  const json=await wikiJson('https://commons.wikimedia.org/w/api.php?'+params({
    action:'query',format:'json',formatversion:2,origin:'*',
    prop:'imageinfo',iiprop:'url|mime|thumbmime|extmetadata',iiurlwidth:330,
    titles:titles.join('|')}),'OSM-linked Commons images');
  const pages:Array<any>=Array.isArray(json.query?.pages)?json.query.pages:[];
  const found:Record<string,BusinessPhoto>={};
  for(const place of named){
    const page=pages.find(p=>businessNameKey(p.title||'')===
      businessNameKey(place.commonsFile||''));
    const photo=commonsPhotoFromPage(page,'Venue image directly linked by OSM');
    if(photo)found[place.id]=photo;
  }
  return found;
}
async function wikipediaBusinessPhotos(places:Place[]):Promise<{
  verified:Record<string,BusinessPhoto>;
  labelled:Record<string,BusinessPhoto>
}>{
  const verified:Record<string,BusinessPhoto>={};
  const labelled:Record<string,BusinessPhoto>={};
  if(!places.length)return {verified,labelled};
  // One batched request rather than one request per spelling or venue.
  const titles=[...new Set(places.flatMap(wikipediaPhotoTitles))].slice(0,40);
  const json=await wikiJson('https://en.wikipedia.org/w/api.php?'+params({
    action:'query',format:'json',formatversion:2,origin:'*',redirects:1,
    prop:'pageimages|coordinates|info',inprop:'url',piprop:'thumbnail',
    pithumbsize:330,pilicense:'free',titles:titles.join('|')
  }),'Wikipedia venue images');
  const pages:Array<any>=Array.isArray(json.query?.pages)?json.query.pages:[];
  for(const place of places){
    const candidates=wikipediaPhotoTitles(place);
    const matching=pages.map(page=>{
      const title=String(page.title||'');
      // Even if another requested venue returned an encyclopedia article
      // about the food, it must never be used as a restaurant photo.
      if(businessNameKey(place.name)==='tortilla'&&
         businessNameKey(title)==='tortilla')return {page,score:0,explicitlyLinked:false};
      // Explicit OSM Wikipedia tags can refer to a renamed business page.
      const nameScore=photoNameSimilarity(place.name,wikiTitleWithoutQualifier(title));
      const requestedScore=Math.max(...candidates.map(v=>
        photoNameSimilarity(v,wikiTitleWithoutQualifier(title))));
      // Require a strong name match, or an explicitly linked article title.
      const score=Math.max(nameScore,requestedScore);
      const explicitlyLinked=!!place.wikipediaTitle&&
        photoNameSimilarity(place.wikipediaTitle,wikiTitleWithoutQualifier(title))>=.88;
      return {page,score,explicitlyLinked};
    }).filter(({page,score})=>score>=.88&&
      typeof page.thumbnail?.source==='string'&&
      page.thumbnail.source.startsWith('https://'))
      .sort((a,b)=>b.score-a.score);
    if(!matching.length)continue;
    const best=matching[0];
    const page=best.page;
    const c=page.coordinates?.[0];
    const hasCoords=c&&Number.isFinite(Number(c.lat))&&
      Number.isFinite(Number(c.lon));
    const close=hasCoords&&haversine(place,{
      latitude:Number(c.lat),longitude:Number(c.lon)})<=150;
    const source=page.fullurl||`https://en.wikipedia.org/wiki/${
      encodeURIComponent(String(page.title).replace(/ /g,'_'))}`;
    if(close){
      verified[place.id]={image:page.thumbnail.source,imagePage:source,
        imageNote:'Nearby Wikipedia article photo (name + coordinates match; confirm subject and licence)'};
    }else if(best.explicitlyLinked||best.score>=.92){
      // A chain's article photo can be a different shop. Never call it exact.
      labelled[place.id]={image:page.thumbnail.source,imagePage:source,
        imageNote:'Brand/article image — NOT a verified photo of this branch'};
    }
  }
  return {verified,labelled};
}
function commonsFileVenueScore(place:Place,rawTitle:string):number{
  const name=canonicalPhotoName(place.name);
  const file=businessNameKey(rawTitle
    .replace(/^(File|Image):/i,'').replace(/\.[^.]+$/,''));
  if(name.length<7||!file)return 0;
  // Strong phrase match, including filenames with city/year and camera details.
  if((' '+file+' ').includes(' '+name+' '))return 1;
  const expected=name.split(' ').filter(t=>t.length>=3);
  const words=file.split(' ').filter(Boolean);
  if(!expected.length)return 0;
  const scores=expected.map(token=>Math.max(0,...words.map(w=>photoEditSimilarity(token,w))));
  const allStrong=scores.every(v=>v>=.83);
  // Use fuzzy spelling only when the ENTIRE distinctive venue name matches.
  return allStrong&&expected.some(t=>t.length>=5)
    ?scores.reduce((a,b)=>a+b,0)/scores.length*.92:0;
}
async function commonsGeoBusinessPhoto(place:Place):Promise<BusinessPhoto|undefined>{
  if(canonicalPhotoName(place.name).length<7)return undefined;
  const json=await wikiJson('https://commons.wikimedia.org/w/api.php?'+params({
    action:'query',format:'json',formatversion:2,origin:'*',
    generator:'geosearch',ggscoord:`${place.latitude}|${place.longitude}`,
    ggsradius:100,ggslimit:25,ggsnamespace:6,
    prop:'imageinfo',iiprop:'url|mime|thumbmime|extmetadata',iiurlwidth:330
  }),`Nearby Commons: ${place.name}`);
  const pages:Array<any>=Array.isArray(json.query?.pages)?json.query.pages:[];
  const ranked=pages.map(page=>({page,score:commonsFileVenueScore(place,String(page.title||''))}))
    .filter(v=>v.score>=.82).sort((a,b)=>b.score-a.score);
  for(const {page} of ranked){
    const photo=commonsPhotoFromPage(page,
      'Nearby geotagged Commons photo — name matched; branch NOT independently verified');
    if(photo)return photo;
  }
  return undefined;
}
async function lookupBusinessPhotos(places:Place[]):Promise<{
  found:Record<string,BusinessPhoto>;errors:string[]
}>{
  const found:Record<string,BusinessPhoto>={};
  const errors:string[]=[];
  if(!places.length)return {found,errors};
  try{Object.assign(found,await commonsLinkedBusinessPhotos(places));}
  catch(e){errors.push(errString(e));}
  const remaining=()=>places.filter(p=>!found[p.id]);
  let articleImages:Record<string,BusinessPhoto>={};
  try{
    const wiki=await wikipediaBusinessPhotos(remaining());
    Object.assign(found,wiki.verified);
    articleImages=wiki.labelled;
  }catch(e){errors.push(errString(e));}
  // Geosearch requests are serial, with an intentionally small per-batch cap;
  // Wikimedia's API can respond "too busy" under load.
  const geo=remaining().slice(0,4);
  for(const p of geo){
    try{
      const candidate=await commonsGeoBusinessPhoto(p);
      if(candidate)found[p.id]=candidate;
    }catch(e){errors.push(errString(e));}
  }
  // Last fallback: labelled illustrative ARTICLE image, not a specific branch.
  for(const place of remaining()){
    if(articleImages[place.id])found[place.id]=articleImages[place.id];
  }
  console.log('[MileMosaic business images]',
    `Found ${Object.keys(found).length}/${places.length}; provider errors: ${errors.length}`);
  return {found,errors};
}

function attractionOrigin(c:City,s:Location|null):City{

  // Use a local starting point, but not a distant airport.
  return s&&haversine(c,s)<=3000
    ? {...c,latitude:s.latitude,longitude:s.longitude}
    : c;
}

function attractionSamples(c:Coord):Coord[]{
  const north=1100/111320;
  const east=1100/(111320*Math.max(
    .25,Math.cos(c.latitude*Math.PI/180)
  ));

  return [
    c,
    {latitude:c.latitude+north,longitude:c.longitude},
    {latitude:c.latitude-north,longitude:c.longitude},
    {latitude:c.latitude,longitude:c.longitude+east},
    {latitude:c.latitude,longitude:c.longitude-east},
  ];
}

async function discoverWideOSM(anchor:City):Promise<Place[]>{
  // Backend returns at most 50 per query.
  // Query 5 areas and combine unique OSM records.
  const responses=await Promise.allSettled(
    attractionSamples(anchor).map(p=>
      api<{places:any[]}>(`/api/attractions?${params({
        lat:p.latitude,
        lon:p.longitude,
        radius:2300,
        limit:50
      })}`)
    )
  );

  const found=new Map<string,Place>();
  let succeeded=0;

  for(const response of responses){
    if(response.status!=='fulfilled')continue;
    succeeded++;

    for(const raw of response.value.places||[]){
      if(!raw.name||!coordOK(raw))continue;

      const place=placeFromOSM(raw,'attraction');
      const distance=haversine(anchor,place);

      if(distance<=3000){
        found.set(place.id,{...place,distance});
      }
    }
  }

  if(!succeeded){
    throw new Error('Attraction API unavailable.');
  }

  return [...found.values()];
}

async function discoverWideWiki(anchor:City):Promise<Place[]>{
  // Different geographic search centres reduce the
  // chance that one neighbourhood consumes all results.
  const points=attractionSamples(anchor);
  const chosen=[points[0],points[2],points[3],points[4]];

  const responses=await Promise.allSettled(
    chosen.map(point=>
      wikipediaNearby({...anchor,...point})
    )
  );

  const found=new Map<string,Place>();

  for(const response of responses){
    if(response.status!=='fulfilled')continue;

    for(const place of response.value){
      const distance=haversine(anchor,place);

      if(distance<=3000){
        found.set(place.id,{...place,distance});
      }
    }
  }

  return [...found.values()];
}

// Explicit search (not typing every character) on Photon's public demo geocoder.
// Production: proxy/cache or self-host. Don't expose private TransCAPI API key in app.
function transportLocationType(p:any):string|null{
  const key=String(p.osm_key||'').toLowerCase();
  const value=String(p.osm_value||'').toLowerCase();

  if(key==='aeroway'&&['aerodrome','terminal'].includes(value))
    return value==='terminal'?'Airport terminal':'Airport';

  if(key==='railway'&&
    ['station','halt','subway_entrance','tram_stop'].includes(value))
    return value==='tram_stop'?'Tram stop':
      value==='subway_entrance'?'Underground station':'Railway station';

  if(key==='amenity'&&value==='bus_station')return 'Bus station';
  if(key==='highway'&&value==='bus_stop')return 'Bus stop';

  if(key==='public_transport'&&
    ['station','platform','stop_position'].includes(value))
    return value==='station'?'Transport station':'Transport stop';

  if(key==='building'&&value==='train_station')
    return 'Railway station';

  return null;
}

async function findUKStart(text:string):Promise<Location[]>{
  const url=`https://photon.komoot.io/api/?${params({
    q:text,limit:50,lang:'en'
  })}`;

  const response=await fetch(url);

  if(!response.ok)
    throw new Error(`Location search unavailable (HTTP ${response.status})`);

  const data:any=await response.json();

  const tokens=text.toLowerCase()
    .replace(/[^a-z0-9 ]/g,' ')
    .split(/\s+/)
    .filter(t=>t.length>2&&![
      'airport','airports','station','stations',
      'railway','train','bus','stop','stops',
      'platform','terminal'
    ].includes(t));

  const results:(Location&{rank:number})[]=[];

  for(const feature of data.features||[]){
    const p=feature.properties||{};
    const category=transportLocationType(p);

    const longitude=num(feature.geometry?.coordinates?.[0]);
    const latitude=num(feature.geometry?.coordinates?.[1]);

    if(!category||
      !Number.isFinite(longitude)||
      !Number.isFinite(latitude)||
      (p.countrycode&&String(p.countrycode).toLowerCase()!=='gb')||
      longitude < -9||longitude > 3||
      latitude < 49||latitude > 60)continue;

    const primary=String(p.name||'');
    if(!primary)continue;

    const name=[primary,p.city||p.county,p.state]
      .filter(Boolean).join(', ');

    const nameLower=primary.toLowerCase();
    const addressLower=name.toLowerCase();

    const nameHits=tokens.filter(t=>nameLower.includes(t)).length;
    const addressHits=tokens.filter(t=>addressLower.includes(t)).length;

    if(tokens.length&&addressHits===0)continue;

    results.push({
      name,latitude,longitude,category,
      rank:nameHits*10+addressHits+(category==='Airport'?2:0)
    });
  }

  results.sort((a,b)=>
    b.rank-a.rank||a.name.localeCompare(b.name)
  );

  return results
    .filter((p,i,all)=>all.findIndex(other=>
      other.name===p.name&&haversine(p,other)<100
    )===i)
    .slice(0,12)
    .map(({rank,...place})=>place);
}
function legMode(l:Leg){return String(l.mode||'').toUpperCase();}
function optionFrom(it:Itinerary,i:number,kind:'transit'|'walk'|'bicycle'):Option{
  const legs=Array.isArray(it.legs)?it.legs:[];
  const modes=legs.map(legMode).filter(x=>x&&x!=='WALK');
  const modeNames=[...new Set(modes.map(m=>m==='BUS'||m==='COACH'?'Bus':
    ['SUBWAY','METRO','UNDERGROUND'].includes(m)?'Tube':
    ['RAIL','TRAIN'].includes(m)?'Train':m==='TRAM'?'Tram':m==='DLR'?'DLR':m))];
  const line=modeNames.length?modeNames.join(' + '):'Public transport';
  const fare=it.fare?.amount_gbp;
  return {id:`${kind}:${i}`,label:kind==='walk'?'Walking':kind==='bicycle'?'Cycling':line,
    icon:kind==='walk'?'🚶':kind==='bicycle'?'🚲':line==='Bus'?'🚌':line==='Tube'?'🚇':'🚆',
    minutes:Math.max(1,Math.round(Number(it.duration_s||legs.reduce((s,l)=>s+(l.duration_s||0),0))/60)),
    fare:kind==='walk'?0:kind==='bicycle'?null:typeof fare==='number'&&Number.isFinite(fare)?fare:null,
    complete:kind==='walk'||it.fare?.complete===true,
    transfers:Math.max(0,legs.filter(l=>l.transit===true||!['WALK','BICYCLE'].includes(legMode(l))).length-1),
    legs,kind,start:it.start_time,end:it.end_time};
}
// MILEMOSAIC_TRANSIT_SERVICE_DROPDOWNS_V53
// Never guess service names or times: display only TransCAPI journey legs.
type ServiceGroup = 'walk'|'tube'|'bus'|'train'|'tram'|'ferry'|'mixed'|'other'|'bicycle';
function serviceGroup(option:Option):ServiceGroup{
  if(option.kind==='walk')return 'walk';
  if(option.kind==='bicycle')return 'bicycle';
  const groups=new Set<string>();
  for(const leg of option.legs){
    const mode=legMode(leg);
    if(!mode||mode==='WALK'||mode==='BICYCLE')continue;
    const group=['SUBWAY','UNDERGROUND','METRO','DLR'].includes(mode)?'tube':
      ['BUS','COACH'].includes(mode)?'bus':
      ['RAIL','TRAIN'].includes(mode)?'train':
      ['TRAM','LIGHT_RAIL'].includes(mode)?'tram':
      ['FERRY','WATER'].includes(mode)?'ferry':'other';
    groups.add(group);
  }
  return groups.size>1?'mixed':(groups.values().next().value||'other') as ServiceGroup;
}
function serviceModeName(leg:Leg):string{
  const m=legMode(leg);
  return m==='BUS'?'Bus':m==='COACH'?'Coach':
    ['SUBWAY','UNDERGROUND','METRO'].includes(m)?'Tube/Metro':
    m==='DLR'?'DLR':['TRAIN','RAIL'].includes(m)?'Train':
    m==='TRAM'?'Tram':m==='FERRY'?'Ferry':m||'Service';
}
function serviceLine(leg:Leg):string{
  return String(leg.route?.line||leg.route?.short_name||leg.line?.short_name||
    leg.route_short_name||leg.route?.long_name||leg.line?.name||'').trim();
}
function serviceTimeValue(time:ServiceTimeValue|undefined):{iso:string|null;live:boolean}{
  if(typeof time==='string')return {iso:time,live:false};
  if(time&&typeof time==='object'){
    if(time.estimated)return {iso:time.estimated,live:true};
    if(time.scheduled)return {iso:time.scheduled,live:false};
  }
  return {iso:null,live:false};
}
function serviceClock(iso:string|null|undefined):string{
  if(!iso)return 'Time unavailable';
  const d=new Date(iso);
  if(!Number.isFinite(d.getTime()))return 'Time unavailable';
  try{return new Intl.DateTimeFormat('en-GB',{
    timeZone:'Europe/London',hour:'2-digit',minute:'2-digit',hour12:false
  }).format(d);}catch{return d.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});}
}
function departureOf(opt:Option):{iso:string|null;live:boolean}{
  const first=opt.legs.find(l=>l.transit||!['WALK','BICYCLE'].includes(legMode(l)));
  const legTime=serviceTimeValue(first?.start_time);
  return legTime.iso?legTime:serviceTimeValue(opt.start);
}
function arrivalOf(opt:Option):{iso:string|null;live:boolean}{
  // Itinerary arrival is door-to-door (includes the final walk).
  const itineraryTime=serviceTimeValue(opt.end);
  if(itineraryTime.iso)return itineraryTime;
  const last=opt.legs[opt.legs.length-1];
  return serviceTimeValue(last?.end_time);
}
function recommendedTripDate(day:number):string{
  const base=new Date();base.setHours(9,30,0,0);
  if(base.getTime()<=Date.now())base.setDate(base.getDate()+1);
  base.setDate(base.getDate()+day-1);
  return [base.getFullYear(),String(base.getMonth()+1).padStart(2,'0'),
    String(base.getDate()).padStart(2,'0')].join('-');
}
function decodePolyline(encoded:string):Coord[]{
  let index=0,lat=0,lng=0;const points:Coord[]=[];
  try{
    while(index<encoded.length&&points.length<5000){
      const delta=()=>{let shift=0,result=0,b=0;
        do{if(index>=encoded.length)throw new Error('bad polyline');b=encoded.charCodeAt(index++)-63;
          result|=(b&31)<<shift;shift+=5;}while(b>=32&&shift<35);
        return (result&1)?~(result>>1):(result>>1);};
      lat+=delta();lng+=delta();points.push({latitude:lat/1e5,longitude:lng/1e5});
    }
  }catch{return [];}
  return points.every(p=>Math.abs(p.latitude)<=90&&Math.abs(p.longitude)<=180)?points:[];
}
function renderRouteCoords(opt:Option|null):Coord[][]{
  return opt?opt.legs.map(l=>typeof l.leg_geometry==='string'?decodePolyline(l.leg_geometry):[])
    .filter(path=>path.length>1):[];
}
function GoogleMode(mode:Option){return mode.kind==='walk'?'walking':mode.kind==='bicycle'?'bicycling':'transit';}
function AppButton({title,onPress,light=false,disabled=false}:{title:string;onPress:()=>void;light?:boolean;disabled?:boolean}){
  return <Pressable disabled={disabled} onPress={onPress} style={[s.button,light&&s.buttonLight,disabled&&{opacity:.45}]}>
    <Text style={[s.buttonText,light&&{color:P.navy}]}>{title}</Text></Pressable>;
}
function Chip({title,active,onPress}:{title:string;active:boolean;onPress:()=>void}){
  return <Pressable onPress={onPress} style={[s.chip,active&&s.chipActive]}>
    <Text style={[s.chipText,active&&{color:P.white}]}>{title}</Text></Pressable>;
}
function Badge({value,kind='neutral'}:{value:string;kind?:'neutral'|'good'|'warn'}){
  return <View style={[s.badge,kind==='good'&&{backgroundColor:'#DAF3E5'},kind==='warn'&&{backgroundColor:'#FFF1D6'}]}>
    <Text style={[s.badgeText,kind==='good'&&{color:P.green},kind==='warn'&&{color:P.warn}]}>{value}</Text></View>;
}
function PanelTitle({small,title,desc}:{small:string;title:string;desc?:string}){
  return <View style={{marginBottom:14}}><Text style={s.kicker}>{small}</Text><Text style={s.title}>{title}</Text>
    {!!desc&&<Text style={s.muted}>{desc}</Text>}</View>;
}


function PlacePhoto({place,onPhotoFailed}:{place:Place;onPhotoFailed?:(p:Place)=>void}){
  const [failed,setFailed]=useState(false);

  useEffect(()=>setFailed(false),[place.image]);

  if(place.image&&!failed){
    return <Image
      source={photoSource(place.image)}
      style={s.placeImage}
      onError={(e:any)=>{
        console.warn(
          '[MileMosaic photo render failed]',
          place.name,
          place.image,
          e.nativeEvent?.error
        );
        setFailed(true);
        if(place.kind!=='attraction'&&!/\.wikimedia\.org\//.test(place.image||''))
          onPhotoFailed?.(place);
      }}
    />;
  }

  return <View style={s.photoFallback}>
    <Text style={{fontSize:27}}>
      {place.kind==='hotel'?'🏨':
       place.kind==='restaurant'?'🍽️':'🏛️'}
    </Text>
    <Text style={s.caption}>Photograph unavailable</Text>
  </View>;
}

